---
// Orthographic globe rendered from real Natural Earth geometry (bundled via the world-atlas
// npm package, no runtime CDN dependency). Highlights countries of demonstrated experience only —
// no site-level markers, no names.
interface Props {
  highlightIds?: string[];
  label?: string;
}
const { highlightIds = ['840', '124', '703', '784'], label = 'EXPERIENCE · NORTH AMERICA · EUROPE · MIDDLE EAST' } = Astro.props;
---
<div class="gss-globe" data-highlight={highlightIds.join(',')} data-label={label}>
  <canvas></canvas>
  <div class="globe-label mono">{label}</div>
</div>

<script>
  import { geoOrthographic, geoPath, geoGraticule10 } from 'd3-geo';
  import { feature, mesh } from 'topojson-client';

  const INK = '#0A0B0C';
  const LAND = '#22282e';
  const LINE = 'rgba(242,240,235,.10)';
  const ACCENT = '#FF7A1A';

  async function initGlobe(root: HTMLElement) {
    const canvas = root.querySelector('canvas');
    if (!canvas) return;
    const ids = (root.dataset.highlight ?? '').split(',').map((s) => s.trim());

    let topology: any;
    try {
      const res = await fetch('/countries-110m.json');
      topology = await res.json();
    } catch {
      return;
    }

    const countries = topology.objects.countries;
    const world = feature(topology, countries) as unknown as { features: Array<{ id?: string | number }> };
    const borders = mesh(topology, countries, (a: any, b: any) => a !== b);

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const projection = geoOrthographic().rotate([-30, -18]);
    const path = geoPath(projection as any, ctx as any);
    const graticule = geoGraticule10();
    const marked = world.features.filter((f) => ids.includes(String(f.id)));
    const plain = world.features.filter((f) => !ids.includes(String(f.id)));

    let w = 0, h = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const size = () => {
      const r = root.getBoundingClientRect();
      w = Math.max(r.width, 200);
      h = Math.max(r.height, 200);
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      (projection as any).fitExtent([[w * 0.1, h * 0.1], [w * 0.9, h * 0.9]], { type: 'Sphere' });
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.beginPath(); path({ type: 'Sphere' } as any);
      ctx.fillStyle = INK; ctx.fill();
      ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(242,240,235,.22)'; ctx.stroke();

      ctx.beginPath(); path(graticule as any);
      ctx.lineWidth = 0.5; ctx.strokeStyle = LINE; ctx.stroke();

      ctx.beginPath(); plain.forEach((f) => path(f as any));
      ctx.fillStyle = LAND; ctx.fill();

      ctx.beginPath(); path(borders as any);
      ctx.lineWidth = 0.5; ctx.strokeStyle = 'rgba(242,240,235,.16)'; ctx.stroke();

      marked.forEach((f) => {
        ctx.beginPath(); path(f as any);
        ctx.fillStyle = ACCENT; ctx.fill();
        ctx.lineWidth = 1; ctx.strokeStyle = ACCENT; ctx.stroke();
      });

      ctx.beginPath(); path({ type: 'Sphere' } as any);
      ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(242,240,235,.28)'; ctx.stroke();
    };

    size();
    draw();
    new ResizeObserver(() => { size(); draw(); }).observe(root);

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      let last = performance.now();
      const tick = (t: number) => {
        const dt = t - last;
        last = t;
        const r = projection.rotate();
        projection.rotate([r[0] + dt * 0.0035, r[1]]);
        draw();
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }

  document.querySelectorAll<HTMLElement>('.gss-globe').forEach(initGlobe);
</script>

<style>
  .gss-globe {
    position: relative;
    background: #0A0B0C;
    min-height: 420px;
    height: 100%;
    width: 100%;
  }
  .gss-globe canvas { display: block; width: 100%; height: 100%; min-height: 420px; }
  .globe-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    font: 500 10.5px/1.6 var(--font-mono);
    letter-spacing: .14em;
    color: var(--accent);
    pointer-events: none;
  }
</style>
