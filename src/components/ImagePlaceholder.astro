---
interface Props {
  caption: string;
  ratio?: string; // aspect-ratio css value, e.g. "16/9"
  minHeight?: string;
  dark?: boolean;
}
const { caption, ratio, minHeight, dark = false } = Astro.props;
---
<div
  class:list={['image-placeholder', { dark }]}
  style={[ratio ? `aspect-ratio:${ratio};` : '', minHeight ? `min-height:${minHeight};` : ''].join('')}
  role="img"
  aria-label={caption}
>
  <div class="frame">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="1" stroke="currentColor" stroke-width="1.4"/>
      <circle cx="8" cy="10" r="1.6" stroke="currentColor" stroke-width="1.4"/>
      <path d="M2 16.5L8 11l4.5 4.5L17 11l5 6" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
    <span>{caption}</span>
  </div>
</div>

<style>
  .image-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--paper-image-bg);
    overflow: hidden;
  }
  .image-placeholder.dark { background: #12161a; }
  .frame {
    position: absolute;
    inset: 14px;
    border: 1px dashed rgba(10, 11, 12, .28);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 16px;
    color: rgba(10, 11, 12, .5);
  }
  .image-placeholder.dark .frame {
    border-color: rgba(242, 240, 235, .22);
    color: rgba(242, 240, 235, .4);
  }
  .frame span {
    font: 500 10.5px/1.5 var(--font-mono);
    letter-spacing: .06em;
    max-width: 34ch;
    text-transform: uppercase;
  }
</style>
