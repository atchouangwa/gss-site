---
import { TOP_NAV, SOLUTIONS, SOLUTION_INTROS, INDUSTRIES, SITE } from '@/lib/site';

type Group = { heading?: string; items: { label: string; slug: string }[] };

// Security is long enough to need sub-groups; the other solutions split evenly into two columns.
const SECURITY_GROUPS: Group[] = [
  {
    heading: 'ASSESS & DESIGN',
    items: [
      { label: 'Security assessment & design', slug: 'security-assessment-design' },
      { label: 'Avenues of approach analysis', slug: 'avenues-of-approach-analysis' },
      { label: 'Adversary pathway & timeline analysis', slug: 'adversary-pathway-analysis' },
      { label: 'Vital area analysis', slug: 'vital-area-analysis' },
      { label: 'Target set identification', slug: 'target-set-identification' },
      { label: 'New build security design', slug: 'new-build-security-design' },
    ],
  },
  {
    heading: 'HARDEN & DELAY',
    items: [
      { label: 'Perimeter security & intrusion detection', slug: 'perimeter-security-intrusion-detection' },
      { label: 'Vehicle & personnel barrier systems', slug: 'barrier-systems' },
      { label: 'Explosive validation & blast-resistant design', slug: 'explosive-validation' },
      { label: 'Access control assessment', slug: 'access-control-assessment' },
      { label: 'Response strategy development', slug: 'response-strategy-development' },
    ],
  },
  {
    heading: 'PROGRAM & PEOPLE',
    items: [
      { label: 'Regulatory compliance & basis documentation', slug: 'regulatory-compliance' },
      { label: 'Security program audits', slug: 'security-program-audits' },
      { label: 'Systematic Approach to Training', slug: 'systematic-approach-to-training' },
      { label: 'Tactical training & train-the-trainer', slug: 'tactical-training' },
      { label: 'Force-on-force readiness', slug: 'force-on-force-readiness' },
      { label: 'Human factors / minimum complement', slug: 'human-factors-minimum-complement' },
      { label: 'Security policy development & optimization', slug: 'security-policy-development' },
    ],
  },
];

function chunk<T>(arr: T[], parts: number): T[][] {
  const size = Math.ceil(arr.length / parts);
  return Array.from({ length: parts }, (_, i) => arr.slice(i * size, (i + 1) * size));
}

const solutionGroups = (path: string, children: Group['items']): Group[] =>
  path === '/security-solutions/' ? SECURITY_GROUPS : chunk(children, 2).map((items) => ({ items }));

const paneId = (path: string) => `sol-pane-${path.replace(/\//g, '')}`;
const tabId = (path: string) => `sol-tab-${path.replace(/\//g, '')}`;
---
<header class="site-header">
  <div class="bar">
    <a href="/" class="brand">
      <img src="/assets/gss-logo.png" alt="GSS" width="30" height="30" />
      <span>Global Security<br />Solutions</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      {TOP_NAV.map((item) => (
        item.kind === 'link' ? (
          <a class="nav-item" href={item.href}>{item.label}</a>
        ) : (
          <div class="nav-item has-mega" data-nav-group={item.kind}>
            <button class="nav-trigger" aria-expanded="false" aria-controls={`mega-${item.kind}`}>
              {item.label}<span class="chev" aria-hidden="true"></span>
            </button>
            {item.kind === 'industries' ? (
              <div class="mega" id="mega-industries" data-mega="industries" hidden>
                <div class="mega-inner industries-inner">
                  <div class="mega-lead">
                    <div class="mega-lead-title">Industries</div>
                  </div>
                  <ul class="industry-list">
                    {INDUSTRIES.map((ind) => (
                      <li><a href={ind.href}><span>{ind.label}</span><span class="arrow" aria-hidden="true">→</span></a></li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <div class="mega" id="mega-solutions" data-mega="solutions" hidden>
                <div class="mega-inner solutions-inner">
                  <div class="sol-rail" role="tablist" aria-orientation="vertical" aria-label="Solutions">
                    {SOLUTIONS.map((sol, i) => (
                      <button
                        class="sol-tab"
                        role="tab"
                        id={tabId(sol.path)}
                        aria-selected={i === 0 ? 'true' : 'false'}
                        aria-controls={paneId(sol.path)}
                        tabindex={i === 0 ? 0 : -1}
                      >
                        <span>{sol.label}</span><span class="arrow" aria-hidden="true">→</span>
                      </button>
                    ))}
                  </div>
                  {SOLUTIONS.map((sol, i) => (
                    <div class="sol-pane" role="tabpanel" id={paneId(sol.path)} aria-labelledby={tabId(sol.path)} hidden={i !== 0}>
                      <div class="mega-lead">
                        <a class="mega-lead-title" href={sol.path}>{sol.label}</a>
                        <p>{SOLUTION_INTROS[sol.path]}</p>
                      </div>
                      {solutionGroups(sol.path, sol.children).map((group) => (
                        <div class="mega-col">
                          {group.heading && <div class="mega-col-heading">{group.heading}</div>}
                          {group.items.map((child) => (
                            <a href={`${sol.path}${child.slug}/`}>{child.label}</a>
                          ))}
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )
      ))}
    </nav>

    <div class="side">
      <a class="phone" href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a>
      <a class="btn btn-accent cta" href="/contact/">Request a Consultation</a>
      <button class="hamburger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  <div class="mobile-nav-scroll">
    {TOP_NAV.map((item) => (
      item.kind === 'link' ? (
        <a class="mobile-top-link" href={item.href}>{item.label}</a>
      ) : item.kind === 'industries' ? (
        <details class="mobile-group">
          <summary>
            <span>{item.label}</span>
            <span class="mobile-toggle" aria-hidden="true"></span>
          </summary>
          <div class="mobile-children">
            {INDUSTRIES.map((ind) => <a href={ind.href}>{ind.label}</a>)}
          </div>
        </details>
      ) : (
        <details class="mobile-group">
          <summary>
            <span>{item.label}</span>
            <span class="mobile-toggle" aria-hidden="true"></span>
          </summary>
          <div class="mobile-children">
            {SOLUTIONS.map((sol) => (
              <details class="mobile-subgroup">
                <summary>
                  <a class="mobile-sol-link" href={sol.path}>{sol.label}</a>
                  <span class="mobile-toggle small" aria-hidden="true"></span>
                </summary>
                <div class="mobile-subchildren">
                  {sol.children.map((child) => (
                    <a href={`${sol.path}${child.slug}/`}>{child.label}</a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      )
    ))}
    <a class="btn btn-accent mobile-cta" href="/contact/">Request a Consultation</a>
    <a class="mobile-phone" href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const groups = Array.from(header.querySelectorAll<HTMLElement>('[data-nav-group]'));
    const triggerOf = (g: HTMLElement) => g.querySelector<HTMLButtonElement>('.nav-trigger')!;
    const panelOf = (g: HTMLElement) => g.querySelector<HTMLElement>('[data-mega]')!;

    let closeTimer: number | undefined;
    let openGroup: HTMLElement | null = null;

    const open = (group: HTMLElement) => {
      window.clearTimeout(closeTimer);
      if (openGroup === group) return;
      groups.forEach((g) => {
        const isOpen = g === group;
        panelOf(g).hidden = !isOpen;
        triggerOf(g).setAttribute('aria-expanded', String(isOpen));
      });
      openGroup = group;
    };
    const close = () => {
      window.clearTimeout(closeTimer);
      groups.forEach((g) => {
        panelOf(g).hidden = true;
        triggerOf(g).setAttribute('aria-expanded', 'false');
      });
      openGroup = null;
    };
    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(close, 160);
    };
    const firstFocusable = (el: HTMLElement) =>
      el.querySelector<HTMLElement>('[role="tab"][aria-selected="true"], a[href], button');

    groups.forEach((group) => {
      const trigger = triggerOf(group);
      group.addEventListener('mouseenter', () => open(group));
      group.addEventListener('mouseleave', scheduleClose);
      trigger.addEventListener('click', () => (openGroup === group ? close() : open(group)));
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          open(group);
          firstFocusable(panelOf(group))?.focus();
        }
      });
      group.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && openGroup === group) {
          e.preventDefault();
          close();
          trigger.focus();
        }
      });
      group.addEventListener('focusout', (e) => {
        const next = e.relatedTarget;
        if (openGroup === group && !(next instanceof Node && group.contains(next))) close();
      });
    });

    document.addEventListener('click', (e) => {
      if (e.target instanceof Node && !header.contains(e.target)) close();
    });

    // Solutions panel: a vertical tab list that switches which solution's pages are shown.
    const tablist = header.querySelector<HTMLElement>('.sol-rail');
    if (tablist) {
      const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          const pane = document.getElementById(t.getAttribute('aria-controls')!);
          if (pane) pane.hidden = !on;
        });
        if (focus) tab.focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('mouseenter', () => select(tab));
        tab.addEventListener('focus', () => select(tab));
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const move = { ArrowDown: 1, ArrowUp: -1 }[e.key];
          if (move) {
            e.preventDefault();
            select(tabs[(i + move + tabs.length) % tabs.length], true);
          } else if (e.key === 'Home' || e.key === 'End') {
            e.preventDefault();
            select(tabs[e.key === 'Home' ? 0 : tabs.length - 1], true);
          }
        });
      });
    }
  }

  const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
  const mobileNav = document.getElementById('mobile-nav');
  hamburger?.addEventListener('click', () => {
    const willOpen = mobileNav?.hasAttribute('hidden');
    if (mobileNav) mobileNav.hidden = !willOpen;
    hamburger.setAttribute('aria-expanded', String(!!willOpen));
    hamburger.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
    document.body.style.overflow = willOpen ? 'hidden' : '';
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    border-bottom: 1px solid var(--ink-border);
  }
  .bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 20px;
    border-right: 1px solid var(--ink-border);
    flex: none;
  }
  .brand img { width: 28px; height: 28px; object-fit: contain; filter: invert(1) brightness(1.4); flex: none; }
  .brand span {
    font: 700 12px/1.15 var(--font-display);
    letter-spacing: .05em;
    color: var(--text-on-ink-primary);
    white-space: nowrap;
  }

  .primary-nav {
    flex: 1;
    display: flex;
    align-items: stretch;
    font: 500 10.5px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text-on-ink-secondary);
    min-width: 0;
  }
  .nav-item {
    display: flex;
    align-items: center;
    padding: 0 13px;
    border-right: 1px solid var(--ink-border-soft);
    color: inherit;
    transition: color var(--dur-hover) var(--ease-out-strong), background var(--dur-hover) var(--ease-out-strong);
    white-space: nowrap;
  }
  a.nav-item:hover, .has-mega:hover .nav-trigger, .nav-trigger[aria-expanded="true"] {
    color: var(--text-on-ink-primary);
    background: var(--ink-raised);
  }
  .nav-trigger {
    all: unset;
    display: flex;
    align-items: center;
    padding: 0 13px;
    cursor: pointer;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    height: 100%;
  }
  .has-mega { border-right: 1px solid var(--ink-border-soft); display: flex; padding: 0; }
  .chev { width: 6px; height: 6px; margin-left: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform 160ms ease; }
  .nav-trigger[aria-expanded="true"] .chev { transform: translateY(1px) rotate(225deg); }

  .side { display: flex; align-items: center; flex: none; }
  .phone {
    font: 500 10.5px/1 var(--font-mono);
    color: var(--text-on-ink-secondary);
    padding: 0 16px;
    border-left: 1px solid var(--ink-border);
    border-right: 1px solid var(--ink-border);
    align-self: stretch;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .cta { border-radius: 0; padding: 20px 20px; font-size: 10.5px; white-space: nowrap; }
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0 18px;
    cursor: pointer;
  }
  .hamburger span { width: 22px; height: 2px; background: var(--text-on-ink-primary); display: block; }

  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--ink-raised);
    border-bottom: 1px solid var(--ink-border);
    text-transform: none;
    letter-spacing: normal;
    white-space: normal;
    cursor: default;
  }
  .mega[hidden], .sol-pane[hidden] { display: none; }
  .mega-inner {
    display: grid;
    grid-template-columns: 280px repeat(3, 1fr);
    max-width: var(--max-content);
    margin: 0 auto;
  }
  .mega-lead {
    padding: 30px 28px 34px;
    border-right: 1px solid var(--ink-border-soft);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mega-lead-title {
    font: 700 26px/1.02 var(--font-display);
    letter-spacing: -.02em;
    text-transform: uppercase;
    color: var(--text-on-ink-primary);
  }
  a.mega-lead-title:hover { color: var(--accent); }
  a.mega-lead-title:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .mega-lead p { margin: 0; font: 400 12.5px/1.6 var(--font-body); color: var(--text-on-ink-secondary); }
  .mega-col {
    padding: 30px 26px 34px;
    border-right: 1px solid var(--ink-border-soft);
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .mega-col:last-child { border-right: none; }
  .mega-col-heading { font: 500 10px/1 var(--font-mono); letter-spacing: .16em; color: var(--text-on-ink-tertiary); }
  .mega-col a {
    font: 400 13px/1.4 var(--font-body);
    color: #dcdedf;
    transition: color 140ms ease;
  }
  .mega-col a:hover { color: var(--accent); }

  .industries-inner { grid-template-columns: 280px 1fr; }
  .industry-list { list-style: none; margin: 0; padding: 18px 28px 22px; display: grid; grid-template-columns: repeat(4, 1fr); }
  .industry-list a {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 16px 20px 16px 0; margin-right: 20px; border-bottom: 1px solid var(--ink-border-soft);
    font: 700 17px/1.1 var(--font-display); letter-spacing: -.01em; text-transform: uppercase;
    color: var(--text-on-ink-primary); transition: color 140ms ease;
  }
  .industry-list a:hover { color: var(--accent); }
  .arrow { color: var(--accent); font: 600 14px/1 var(--font-body); }

  .solutions-inner { grid-template-columns: 240px 1fr; }
  .sol-rail { display: flex; flex-direction: column; padding: 22px 0; border-right: 1px solid var(--ink-border-soft); }
  .sol-tab {
    all: unset; box-sizing: border-box; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center;
    padding: 15px 24px; border-left: 2px solid transparent;
    font: 700 17px/1.1 var(--font-display); letter-spacing: -.01em; text-transform: uppercase;
    color: var(--text-on-ink-secondary); transition: color 140ms ease, background 140ms ease;
  }
  .sol-tab .arrow { opacity: 0; transition: opacity 140ms ease; }
  .sol-tab[aria-selected="true"] { color: var(--text-on-ink-primary); background: var(--ink-raised-2); border-left-color: var(--accent); }
  .sol-tab[aria-selected="true"] .arrow { opacity: 1; }
  .sol-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .sol-pane { display: grid; grid-template-columns: 260px repeat(3, 1fr); }
  .sol-pane .mega-col:empty { display: none; }

  .mobile-nav {
    position: fixed;
    inset: 0;
    top: 0;
    z-index: 200;
    background: var(--ink);
    overflow-y: auto;
  }
  .mobile-nav-scroll { padding: 84px 18px 40px; display: flex; flex-direction: column; }
  .mobile-top-link {
    font: 700 17px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--text-on-ink-primary);
    padding: 16px 0;
    border-top: 1px solid var(--ink-border-soft);
  }
  .mobile-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-top: 1px solid var(--ink-border-soft);
    font: 700 17px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--text-on-ink-primary);
    cursor: pointer;
    list-style: none;
  }
  .mobile-group summary::-webkit-details-marker { display: none; }
  .mobile-toggle { position: relative; width: 14px; height: 14px; }
  .mobile-toggle::before, .mobile-toggle::after {
    content: ''; position: absolute; background: var(--text-on-ink-secondary);
  }
  .mobile-toggle::before { top: 6px; left: 0; width: 14px; height: 2px; }
  .mobile-toggle::after { top: 0; left: 6px; width: 2px; height: 14px; transition: transform 160ms ease; }
  .mobile-group[open] > summary .mobile-toggle::after { transform: scaleY(0); }
  .mobile-children { display: flex; flex-direction: column; padding-bottom: 10px; }
  .mobile-children a {
    font: 400 13px/1 var(--font-body);
    color: var(--text-on-ink-secondary);
    padding: 12px 0 12px 14px;
  }
  .mobile-subgroup summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 13px 0 13px 14px; cursor: pointer; list-style: none;
    font: 600 14px/1.2 var(--font-body); color: var(--text-on-ink-primary);
  }
  .mobile-subgroup summary::-webkit-details-marker { display: none; }
  .mobile-children .mobile-sol-link { font: inherit; color: inherit; padding: 0; }
  .mobile-toggle.small { width: 10px; height: 10px; }
  .mobile-toggle.small::before { top: 4px; width: 10px; }
  .mobile-toggle.small::after { left: 4px; height: 10px; }
  .mobile-subgroup[open] > summary .mobile-toggle::after { transform: scaleY(0); }
  .mobile-subchildren { display: flex; flex-direction: column; padding-bottom: 8px; }
  .mobile-subchildren a { font: 400 13px/1.3 var(--font-body); color: var(--text-on-ink-secondary); padding: 10px 0 10px 28px; }
  .mobile-cta { margin-top: 24px; padding: 17px; }
  .mobile-phone { margin-top: 16px; text-align: center; font: 500 12px/1 var(--font-mono); color: var(--text-on-ink-secondary); padding: 12px; }

  @media (max-width: 1300px) {
    .primary-nav, .side .phone, .side .cta { display: none; }
    .hamburger { display: flex; }
  }

  @media (max-width: 480px) {
    .brand { padding: 14px; gap: 8px; }
    .brand img { width: 24px; height: 24px; }
    .brand span { font-size: 10.5px; }
    .hamburger { padding: 0 14px; }
  }
</style>
