---
import { SITE } from '@/lib/site';

const areas = ['Security solutions', 'Technology', 'Cybersecurity', 'Nuclear & SMR', 'High performance'];
const facilityTypes = ['Operating nuclear', 'SMR', 'New build', 'Other critical infrastructure', 'Other'];
---
<form class="consult-form" id="consult-form" novalidate>
  <div class="grid">
    <label class="field">
      <span class="mono label">NAME *</span>
      <input type="text" name="name" required autocomplete="name" placeholder="Full name" />
    </label>
    <label class="field">
      <span class="mono label">TITLE</span>
      <input type="text" name="title" autocomplete="organization-title" placeholder="Role" />
    </label>
    <label class="field">
      <span class="mono label">ORGANIZATION *</span>
      <input type="text" name="organization" required autocomplete="organization" placeholder="Utility, agency, or company" />
    </label>
    <label class="field">
      <span class="mono label">FACILITY TYPE</span>
      <select name="facilityType">
        <option value="">Select one</option>
        {facilityTypes.map((f) => <option value={f}>{f}</option>)}
      </select>
    </label>
    <label class="field">
      <span class="mono label">EMAIL *</span>
      <input type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    </label>
    <label class="field">
      <span class="mono label">PHONE</span>
      <input type="tel" name="phone" autocomplete="tel" placeholder="Optional" />
    </label>
  </div>

  <fieldset class="areas">
    <legend class="mono label">AREA OF INTEREST</legend>
    <div class="chips">
      {areas.map((area, i) => (
        <label class="chip">
          <input type="checkbox" name="areaOfInterest" value={area} checked={i === 0} />
          <span>{area}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <label class="field message">
    <span class="mono label">MESSAGE</span>
    <textarea name="message" rows="4" placeholder="What are you trying to establish, and by when?"></textarea>
  </label>

  <p class="notice">
    Submissions route to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Please do not include sensitive facility detail in this form.
  </p>

  <div class="submit-row">
    <span class="status mono" data-status role="status" aria-live="polite"></span>
    <button class="btn btn-accent" type="submit" data-submit>Send request</button>
  </div>
</form>

<script>
  const form = document.getElementById('consult-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (status) status.textContent = 'SENDING…';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('Request failed');
      if (status) status.textContent = 'REQUEST SENT — WE WILL RESPOND SHORTLY.';
      form.reset();
    } catch {
      if (status) status.textContent = "SOMETHING WENT WRONG — EMAIL US DIRECTLY AT CONTACT@GSSCORPORATE.COM.";
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send request'; }
    }
  });
</script>

<style>
  .consult-form { display: flex; flex-direction: column; gap: 26px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  .field { display: flex; flex-direction: column; gap: 6px; padding: 14px 0; border-top: 1px solid var(--ink); }
  .field:nth-child(n+3) { border-top-color: var(--paper-border); }
  .label { font: 500 9.5px/1 var(--font-mono); letter-spacing: .14em; color: var(--text-on-paper-quiet); }
  input, select, textarea {
    font: 400 14px/1.3 var(--font-body);
    color: var(--ink);
    border: none;
    background: transparent;
    padding: 0;
    outline: none;
  }
  input::placeholder, textarea::placeholder { color: #a5a09a; }
  .field:focus-within .label { color: var(--accent-ink); }
  .field:focus-within { box-shadow: inset 0 -2px 0 var(--accent); }

  .areas { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .areas legend { padding: 0; margin-bottom: 4px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    position: relative;
    border: 1px solid #b8b4ad;
    color: var(--text-on-paper-tertiary);
    font: 500 11.5px/1 var(--font-body);
    letter-spacing: .06em;
    text-transform: uppercase;
    padding: 10px 13px;
    cursor: pointer;
    transition: border-color 160ms ease;
  }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip:has(input:checked) { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .chip:hover { border-color: var(--ink); }

  .message textarea { resize: vertical; min-height: 76px; font-family: var(--font-body); line-height: 1.6; border-top: 1px solid var(--paper-border); padding-top: 8px; }
  .message { border-top: none; padding-top: 0; }

  .notice { margin: 0; font: 400 12px/1.6 var(--font-body); color: var(--text-on-paper-tertiary); }

  .submit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 8px;
    border-top: 1px solid var(--ink);
    flex-wrap: wrap;
  }
  .status { font: 400 10.5px/1.5 var(--font-mono); color: var(--text-on-paper-quiet); }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
