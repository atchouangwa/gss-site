---
import Layout from './Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { SITE } from '@/lib/site';
import { overviewImages } from '@/lib/images';

type IndexItem = { label: string; slug?: string; href?: string };
/** One content section: a short heading over one of the page's existing paragraphs. */
type Section = { heading: string; body: string };

interface Props {
  eyebrow: string;
  title: string;
  /** Hero intro. Omit and set `pendingNote` when approved copy has not been supplied yet. */
  dek?: string;
  pendingNote?: string;
  path: string;
  metaDescription: string;
  /**
   * Content sections between the hero and the capability list. Backgrounds alternate:
   * the first is cream, the second black over the page's feature photo. Every page
   * currently has two, so the cream capability section always follows a black one.
   */
  sections: Section[];
  /** Lead-in sentence shown above the CAPABILITIES list, when the page has one. */
  indexIntro?: string;
  children: IndexItem[];
  indexLabel?: string;
  ctaHeading: string;
  noindex?: boolean;
}
const { eyebrow, title, dek, pendingNote, path, metaDescription, sections, indexIntro, children, indexLabel = 'CAPABILITIES', ctaHeading, noindex = false } = Astro.props;
const hrefOf = (c: IndexItem) => c.href ?? `${path}${c.slug}/`;
const photos = overviewImages(path);
const pad2 = (n: number) => String(n).padStart(2, '0');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: title, item: SITE.url + path },
    ],
  },
];
---
<Layout title={`${title} | GSS`} description={metaDescription} path={path} jsonLd={jsonLd} noindex={noindex}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />

  <!-- 01 Introduction: compact black header in the home page's style, photo right. -->
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="mono">{eyebrow}</span>
        <span class="eyebrow-rule"></span>
      </div>
      <h1>{title}</h1>
      <span class="title-rule" aria-hidden="true"></span>
      {dek && <p class="dek">{dek}</p>}
      {pendingNote && <p class="pending mono">{pendingNote}</p>}
    </div>
    <div class="hero-image">
      <ImagePlaceholder caption={photos.hero.alt} dark src={photos.hero.src} alt={photos.hero.alt} loading="eager" />
    </div>
  </section>

  <!-- 02, 03 Content sections: cream, then black over the feature photo. -->
  {sections.map((s, i) => {
    const dark = i % 2 === 1;
    return (
      <section class:list={['content', dark ? 'content--dark' : 'content--paper', { 'has-photo': dark && i === 1 }]}>
        {dark && i === 1 && (
          <div class="content-photo" aria-hidden="true">
            <img src={photos.feature.src} alt="" loading="lazy" decoding="async" />
          </div>
        )}
        <div class="content-inner" data-reveal>
          <span class="mono idx">{pad2(i + 2)}</span>
          <div>
            <h2>{s.heading}</h2>
            <span class="heading-rule" aria-hidden="true"></span>
            <p>{s.body}</p>
          </div>
        </div>
      </section>
    );
  })}

  <!-- Capabilities: the label sits directly above the numbered links. -->
  <section class="index">
    {indexIntro && <p class="index-intro" data-reveal>{indexIntro}</p>}
    <div class="rule-row"><span class="mono">{indexLabel}</span><span class="rule"></span></div>
    <div class="grid">
      {children.map((c, i) => (
        <a class="card" href={hrefOf(c)} data-reveal>
          <span class="mono n">{pad2(i + 1)}</span>
          <span class="label">{c.label}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <CTASection variant="dark" heading={ctaHeading} />
</Layout>

<style>
  /* HERO: shorter than the home hero; copy left, photo right. */
  .hero { background: var(--ink); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 42%); border-bottom: 1px solid var(--ink-border); }
  .hero-copy { padding: 52px var(--page-pad) 48px; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--ink-border); }
  .hero-eyebrow { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .hero-eyebrow .mono { color: var(--accent); letter-spacing: .22em; font-size: 10px; white-space: nowrap; }
  .eyebrow-rule { flex: 1; max-width: 120px; height: 1px; background: var(--ink-border-strong); }
  .hero h1 { margin: 0; max-width: 18ch; font: 700 clamp(32px, 4.6vw, 60px)/.98 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; color: var(--text-on-ink-primary); }
  .title-rule { display: block; width: min(100%, 560px); height: 1px; margin-top: 24px; background: var(--ink-border-strong); }
  .dek { margin: 20px 0 0; max-width: 56ch; font: 400 16.5px/1.6 var(--font-body); color: #a9afb5; }
  .pending { display: inline-block; align-self: flex-start; margin: 20px 0 0; padding: 12px 14px; border: 1px dashed var(--accent); color: var(--accent); font-size: 11px; letter-spacing: .14em; }
  .hero-image { position: relative; min-height: 360px; }

  /* CONTENT SECTIONS: sized to their content; heading, short orange rule, paragraph. */
  .content { position: relative; overflow: hidden; }
  .content--paper { background: var(--paper); border-bottom: 1px solid var(--paper-border); }
  .content--dark { background: var(--ink); border-bottom: 1px solid var(--ink-border); }
  .content-inner { position: relative; display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 40px; padding: 68px var(--page-pad) 72px; max-width: var(--max-content); margin: 0 auto; }
  .idx { font-size: 11px; letter-spacing: .18em; color: var(--accent-ink); padding-top: 8px; }
  .content h2 { margin: 0; max-width: 22ch; font: 700 clamp(28px, 3.4vw, 46px)/1 var(--font-display); letter-spacing: -.03em; text-transform: uppercase; color: var(--ink); }
  .heading-rule { display: block; width: 64px; height: 2px; margin: 22px 0 22px; background: var(--accent); }
  .content p { margin: 0; max-width: 68ch; font: 400 16px/1.75 var(--font-body); color: var(--text-on-paper-tertiary); }

  .content--dark .idx { color: var(--accent); }
  .content--dark h2 { color: var(--text-on-ink-primary); }
  .content--dark p { color: #b7bcc1; }

  /* Feature photo behind the black section, darkened toward the text side. */
  .content-photo { position: absolute; inset: 0; }
  .content-photo img { width: 100%; height: 100%; object-fit: cover; }
  .content-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10, 11, 12, .94) 0%, rgba(10, 11, 12, .86) 48%, rgba(10, 11, 12, .45) 100%); }
  .has-photo .content-inner { padding-top: 88px; padding-bottom: 92px; }

  /* CAPABILITIES: cream, two-column card grid. */
  .index { background: var(--paper); padding: 56px var(--page-pad) 64px; max-width: var(--max-content); margin: 0 auto; }
  .index-intro { margin: 0 0 28px; max-width: 68ch; font: 400 16px/1.7 var(--font-body); color: var(--text-on-paper-tertiary); }
  .rule-row { display: flex; align-items: baseline; gap: 16px; margin-bottom: 18px; }
  .rule-row .rule { flex: 1; height: 1px; background: var(--ink); }
  .rule-row .mono { font-size: 11px; letter-spacing: .2em; color: var(--ink); font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .card { display: grid; grid-template-columns: 34px 1fr 20px; align-items: center; gap: 14px; padding: 18px 20px; border: 1px solid var(--paper-border); background: var(--paper); transition: border-color var(--dur-hover) ease, background var(--dur-hover) ease, opacity var(--dur-reveal) var(--ease-out-strong), transform var(--dur-reveal) var(--ease-out-strong); }
  .card:hover { border-color: var(--ink); background: var(--paper-hover); }
  .card:hover .arrow { transform: translateX(3px); }
  .n { font-size: 11px; color: var(--accent-ink); }
  .label { font: 700 17px/1.15 var(--font-display); letter-spacing: -.01em; text-transform: uppercase; color: var(--ink); }
  .arrow { font: 600 16px/1 var(--font-body); color: var(--accent-ink); justify-self: end; transition: transform 180ms var(--ease-out-strong); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-copy { padding: 36px var(--page-pad) 32px; border-right: none; }
    .hero-eyebrow .mono { white-space: normal; line-height: 1.6; }
    .title-rule { margin-top: 18px; }
    .hero-image { min-height: 200px; aspect-ratio: 16 / 9; border-top: 1px solid var(--ink-border); }
    .content-inner, .has-photo .content-inner { grid-template-columns: 1fr; gap: 10px; padding: 40px var(--page-pad) 44px; }
    .idx { padding-top: 0; }
    .heading-rule { margin: 16px 0; }
    .content p { font-size: 15.5px; }
    .content-photo::after { background: rgba(10, 11, 12, .84); }
    .index { padding: 40px var(--page-pad) 44px; }
    .index-intro { font-size: 15.5px; margin-bottom: 22px; }
    .grid { grid-template-columns: 1fr; gap: 8px; }
    .card { grid-template-columns: 28px 1fr 18px; padding: 16px; }
    .label { font-size: 16px; }
  }
</style>
