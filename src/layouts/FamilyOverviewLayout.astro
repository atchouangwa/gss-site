---
import Layout from './Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE } from '@/lib/site';

type IndexItem = { label: string; slug?: string; href?: string };

interface Props {
  eyebrow: string;
  title: string;
  /** Hero intro. Omit and set `pendingNote` when approved copy has not been supplied yet. */
  dek?: string;
  pendingNote?: string;
  path: string;
  metaDescription: string;
  paragraphs: string[];
  children: IndexItem[];
  indexLabel?: string;
  ctaHeading: string;
  noindex?: boolean;
}
const { eyebrow, title, dek, pendingNote, path, metaDescription, paragraphs, children, indexLabel = 'CAPABILITIES', ctaHeading, noindex = false } = Astro.props;
const hrefOf = (c: IndexItem) => c.href ?? `${path}${c.slug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: title, item: SITE.url + path },
    ],
  },
];
---
<Layout title={`${title} | GSS`} description={metaDescription} path={path} jsonLd={jsonLd} noindex={noindex}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />

  <section class="hero">
    <span class="mono eyebrow accent-ink">{eyebrow}</span>
    <h1>{title}</h1>
    {dek && <p class="dek">{dek}</p>}
    {pendingNote && <p class="pending mono">{pendingNote}</p>}
  </section>

  <section class="body">
    {paragraphs.map((p) => <p>{p}</p>)}
  </section>

  <section class="index">
    <div class="rule-row"><span class="mono dim">{indexLabel}</span><span class="rule"></span></div>
    <div class="list">
      {children.map((c, i) => (
        <a class:list={['row', { 'no-slug': !c.slug }]} href={hrefOf(c)}>
          <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
          <span class="label">{c.label}</span>
          {c.slug && <span class="mono slug dim">{c.slug}</span>}
          <span class="arrow accent-ink">→</span>
        </a>
      ))}
    </div>
  </section>

  <CTASection variant="dark" heading={ctaHeading} />
</Layout>

<style>
  .accent-ink { color: var(--accent-ink); }
  .dim { color: var(--text-on-paper-quiet); }
  .hero { padding: 64px var(--page-pad) 36px; border-bottom: 1px solid var(--paper-border); max-width: var(--max-content); margin: 0 auto; }
  .eyebrow { letter-spacing: .2em; font-size: 10px; margin-bottom: 24px; display: block; }
  .hero h1 { margin: 0 0 22px; font: 700 clamp(34px, 5.5vw, 64px)/1 var(--font-display); letter-spacing: -.04em; text-transform: uppercase; color: var(--ink); max-width: 22ch; }
  .dek { margin: 0; max-width: 68ch; font: 400 17px/1.7 var(--font-body); color: var(--text-on-paper-secondary); }
  .pending { display: inline-block; margin: 0; padding: 12px 14px; border: 1px dashed var(--accent-ink); color: var(--accent-ink); font-size: 11px; letter-spacing: .14em; }

  .body { padding: 44px var(--page-pad) 56px; border-bottom: 1px solid var(--paper-border); max-width: var(--max-content); margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
  .body p { margin: 0; max-width: 74ch; font: 400 15.5px/1.75 var(--font-body); color: var(--text-on-paper-tertiary); }

  .index { padding: 56px var(--page-pad) 64px; max-width: var(--max-content); margin: 0 auto; }
  .rule-row { display: flex; align-items: baseline; gap: 16px; margin-bottom: 26px; }
  .rule-row .rule { flex: 1; height: 1px; background: var(--paper-border-soft); }
  .rule-row .mono { font-size: 10px; letter-spacing: .18em; }
  .list { display: flex; flex-direction: column; }
  .row { display: grid; grid-template-columns: 40px 1fr auto 24px; align-items: center; gap: 16px; padding: 18px 0; border-top: 1px solid var(--paper-border-soft); transition: padding-left 180ms var(--ease-out-strong), background 160ms ease; }
  .row.no-slug { grid-template-columns: 40px 1fr 24px; }
  .row:first-child { border-top-color: var(--ink); }
  .row:last-child { border-bottom: 1px solid var(--ink); }
  .row:hover { padding-left: 10px; background: var(--paper-hover); }
  .n { font-size: 10px; }
  .label { font: 700 20px/1.1 var(--font-display); letter-spacing: -.015em; text-transform: uppercase; color: var(--ink); }
  .slug { font-size: 10.5px; }
  .arrow { font: 600 16px/1 var(--font-body); }

  @media (max-width: 700px) {
    .row { grid-template-columns: 30px 1fr 20px; }
    .slug { display: none; }
  }
</style>
