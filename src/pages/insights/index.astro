---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE } from '@/lib/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: SITE.url + '/insights/' },
    ],
  },
];

const articles = (await getCollection('insights')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
const [lead, ...rest] = articles;
---
<Layout
  title="Insights | Nuclear Security & Critical Infrastructure | GSS"
  description="Analysis on nuclear security, physical protection, regulatory compliance, cyber-physical security, and operational performance from Global Security Solutions."
  path="/insights/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Insights' }]} />

  <section class="hero">
    <span class="mono eyebrow accent-ink">INSIGHTS</span>
    <h1>Insight grounded in experience</h1>
    <p class="dek">Written by the same professionals who perform GSS assessments and work directly with complex security programs, for readers who value technical depth and practical insight.</p>
  </section>

  {lead && (
    <section class="lead">
      <a href={`/insights/${lead.id}/`}>
        <span class="mono tag accent-ink">{lead.data.category.toUpperCase()} · {lead.data.readMinutes} MIN</span>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.dek}</p>
      </a>
    </section>
  )}

  <section class="grid">
    {rest.map((a) => (
      <a class="card" href={`/insights/${a.id}/`}>
        <span class="mono tag dim">{a.data.category.toUpperCase()} · {a.data.readMinutes} MIN</span>
        <span class="title">{a.data.title}</span>
        <span class="dek">{a.data.dek}</span>
      </a>
    ))}
  </section>

  <CTASection heading="Have a question an article didn't answer?" body="Ask the people who wrote it." />
</Layout>

<style>
  .accent-ink { color: var(--accent-ink); }
  .dim { color: var(--text-on-paper-quiet); }
  .hero { padding: 64px var(--page-pad) 40px; border-bottom: 1px solid var(--paper-border); max-width: var(--max-content); margin: 0 auto; }
  .eyebrow { letter-spacing: .2em; font-size: 10px; margin-bottom: 24px; display: block; }
  .hero h1 { margin: 0 0 20px; font: 700 clamp(34px, 5.5vw, 60px)/1 var(--font-display); letter-spacing: -.04em; text-transform: uppercase; color: var(--ink); }
  .dek { margin: 0; max-width: 64ch; font: 400 16px/1.7 var(--font-body); color: var(--text-on-paper-secondary); }

  .lead { padding: 48px var(--page-pad) 40px; border-bottom: 1px solid var(--paper-border); max-width: var(--max-content); margin: 0 auto; }
  .lead a { display: flex; flex-direction: column; gap: 14px; }
  .tag { font-size: 10px; letter-spacing: .16em; }
  .lead h2 { margin: 0; font: 700 clamp(30px, 4.4vw, 48px)/1.02 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; color: var(--ink); max-width: 24ch; }
  .lead p { margin: 0; max-width: 68ch; font: 400 15px/1.7 var(--font-body); color: var(--text-on-paper-tertiary); }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); border-bottom: 1px solid var(--paper-border); max-width: var(--max-content); margin: 0 auto; }
  .card { padding: 32px var(--page-pad) 32px 0; border-top: 1px solid var(--paper-border-soft); border-right: 1px solid var(--paper-border-soft); display: flex; flex-direction: column; gap: 10px; transition: background 160ms ease; }
  .card:nth-child(odd) { padding-left: var(--page-pad); }
  .card:nth-child(even) { border-right: none; }
  .card:hover { background: var(--paper-hover); }
  .card .title { font: 600 18px/1.35 var(--font-body); color: var(--ink); }
  .card .dek { font: 400 13.5px/1.6 var(--font-body); color: var(--text-on-paper-tertiary); }

  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
    .card:nth-child(even) { border-right: 1px solid var(--paper-border-soft); }
  }
</style>
