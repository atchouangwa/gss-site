---
import { getCollection } from 'astro:content';
import SolutionCapabilityLayout from '@/layouts/SolutionCapabilityLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('capabilities', (e) => e.data.family === 'security-solutions');
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = Astro.params.slug as string;
---
<SolutionCapabilityLayout entry={entry} slug={slug} />
