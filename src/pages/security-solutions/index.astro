---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/security-solutions/')!;
---
<FamilyOverviewLayout
  eyebrow="SECURITY SOLUTIONS"
  title="Security Solutions"
  dek="GSS evaluates and assesses physical, procedural, and electronic security systems as one integrated system, pioneering new designs to cater to each client's unique needs."
  path="/security-solutions/"
  metaDescription="GSS security solutions, including assessment and design, adversary pathway analysis, barrier and detection systems, training, and regulatory support for nuclear and critical infrastructure."
  sections={[
    { heading: 'Existing Facilities and New Builds', body: "Existing facilities require maintenance and realignment to remain as efficient and effective as possible. Our team analyzes the existing system as a whole to modernize it and adapt it to a changing world. This understanding of the modern security market also allows us to provide best-in-class services for new builds, preparing them for the future." },
    { heading: 'Holistic Approach', body: "GSS's objective is to understand how the security program performs as a whole. We look at where individual measures are effective, where gaps exist between them, and whether personnel, procedures, and technology work together under realistic conditions. This allows improvements to be focused where they will have the greatest impact on overall security performance." },
  ]}
  indexIntro="The capabilities below can address specific security needs individually or work together as part of a broader security program."
  children={family.children}
  variant="solution"
  ctaHeading="Start with an assessment, or bring us in on a build already underway."
/>
