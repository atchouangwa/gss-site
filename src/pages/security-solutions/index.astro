---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/security-solutions/')!;
---
<FamilyOverviewLayout
  eyebrow="SECURITY SOLUTIONS"
  title="Security Solutions"
  dek="Physical, procedural, and electronic security designed and assessed as one integrated system."
  path="/security-solutions/"
  metaDescription="GSS security solutions, including assessment and design, adversary pathway analysis, barrier and detection systems, training, and regulatory support for nuclear and critical infrastructure."
  paragraphs={[
    "For existing facilities, GSS assesses security from the outside in, examining each layer from the perimeter and controlled areas through detection, access control, response, and protection of critical assets. For new builds, we work from the inside out, starting with the assets that require protection and designing the security architecture around them.",
    "In both cases, the objective is to understand how the security program performs as a whole. We look at where individual measures are effective, where gaps exist between them, and whether personnel, procedures, and technology work together under realistic conditions. This allows improvements to be focused where they will have the greatest impact on overall security performance.",
    "The capabilities below can address specific security needs individually or work together as part of a broader security program.",
  ]}
  children={family.children}
  ctaHeading="Start with an assessment, or bring us in on a build already underway."
/>
