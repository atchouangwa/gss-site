---
import Layout from '@/layouts/Layout.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { SITE_PHOTOS } from '@/lib/images';
import Globe from '@/components/Globe.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE } from '@/lib/site';

const architectureLayers = [
  { n: 'L1', label: 'Physical', items: ['Barrier systems', 'Access control', 'Intrusion detection', 'Surveillance', 'Target hardening'] },
  { n: 'L2', label: 'Procedural', items: ['Protective strategy', 'Response planning', 'Training', 'Force-on-force', 'Policy & basis documentation'] },
  { n: 'L3', label: 'Technology', items: ['Establish comms network', 'Rapidly deployable IDS', 'Monitoring & alarms', 'Drone programs', 'Systems integration'] },
  { n: 'L4', label: 'Cybersecurity', items: ['Risk-based controls', 'Penetration testing', 'Governance', 'Threat hunting', 'Vulnerability exposure', 'Incident response'] },
  { n: 'L5', label: 'Performance', items: ['KPI development', 'Optimization', 'Leadership', 'Culture', 'Continuous improvement'] },
];

const techItems = [
  { n: '01', title: 'Secure Wireless Communications', body: 'Encrypted mesh communications with frequency hopping and dynamic routing, deployable as a compensatory measure or a permanent capability.', tags: 'AES-256 · FIPS 140-3 · MESH / PEER-TO-PEER' },
  { n: '02', title: 'Rapidly Deployable IDS', body: 'Thermal and CCD assessment with buried, fence-mounted, microwave, and taut-wire detection, configured per site to meet regulatory requirements.', tags: 'INTERIM OR PERMANENT · PIDAS-CAPABLE' },
  { n: '03', title: 'Drone Program Development', body: 'Threat assessment, airspace control, detection and tracking, countermeasures, and an escalation framework that stays inside regulation.', tags: 'RADAR · RF · GEO-FENCING · RESPONSE' },
];

const cyberList = ['Security assessments', 'Risk-based security controls', 'Penetration testing', 'Risk & vulnerability management', 'Compliance advisory', 'Governance', 'Threat hunting', 'Incident response', 'Security operations', 'Training & education'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }],
  },
];
---
<Layout
  title="Global Security Solutions | Security Engineering & Critical Infrastructure"
  description="Global Security Solutions, LLC helps organizations assess, design, and strengthen security programs for critical infrastructure and other high-consequence environments. Our work spans physical protection, technology, cybersecurity, regulatory support, and operational performance, with an integrated approach to how security systems perform in practice."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="mono">01 – SECURITY ENGINEERING &amp; CRITICAL INFRASTRUCTURE</span>
          <span class="scan-rule"><span></span></span>
        </div>
        <h1 class="gss-rise">Security engineering<span class="dim">,</span> physical protection <span class="dim">&amp;</span> critical infrastructure solutions</h1>
        <div class="hero-sub">
          <p>GSS helps critical infrastructure organizations worldwide assess and strengthen their security programs. We evaluate how people, procedures, technology, and response work together as an integrated system under realistic conditions. This approach reveals gaps that separate reviews can miss and helps leadership understand how effectively their facilities are protected.</p>
          <div class="hero-ctas">
            <a class="btn btn-accent" href="/contact/">Request a Consultation</a>
            <a class="btn btn-outline-on-ink" href="/security-solutions/">Explore Capabilities</a>
          </div>
        </div>
        <div class="hero-meta mono">
          <span>{SITE.founded}</span><span>{SITE.regionsLine}</span><span>PHYSICAL · PROCEDURAL · ELECTRONIC</span>
          <span class="brand-line">{SITE.brandLine.toUpperCase()}</span>
        </div>
      </div>
      <div class="hero-image">
        <ImagePlaceholder caption="Hero photo, containment structure or lit perimeter at dusk, tall crop" dark src={SITE_PHOTOS.nuclearDusk.src} alt={SITE_PHOTOS.nuclearDusk.alt} objectPosition="center 30%" />
      </div>
    </div>
  </section>

  <section class="stats">
    <div data-reveal class="stat"><div class="num">{SITE.facilityCount}</div><div class="label mono">NUCLEAR FACILITIES<br />SUPPORTED</div></div>
    <div data-reveal class="stat"><div class="num">{SITE.yearsExperience}</div><div class="label mono">YEARS OF NUCLEAR<br />SECURITY EXPERIENCE</div></div>
    <div data-reveal class="stat"><div class="num">{SITE.regulatoryRegimes}</div><div class="label mono">NATIONAL REGULATORY<br />REGIMES WORKED UNDER</div></div>
  </section>

  <section class="architecture">
    <div class="section-head">
      <div class="section-idx mono">02<br />INTEGRATED<br />SECURITY</div>
      <div>
        <h2>Security must work as a system.</h2>
        <p>GSS evaluates how personnel, procedures, technology, and response work together, not how each component performs on its own. We identify gaps between those elements and help strengthen the overall security program from assessment through implementation.</p>
      </div>
    </div>
    <div class="layers">
      {architectureLayers.map((layer, i) => (
        <div data-reveal class="layer" style={`padding-left:${i * 40}px`}>
          <div class="layer-label"><span class="mono accent">{layer.n}</span><span class="layer-name">{layer.label}</span></div>
          <div class="layer-items">{layer.items.map((it) => <span>{it}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="global">
    <div class="global-copy">
      <div class="eyebrow-row"><span class="mono dim">03 – GLOBAL EXPERIENCE</span><span class="rule"></span></div>
      <h2>Regions Serviced</h2>
      <p>GSS has supported major critical infrastructure facilities. Client organizations, sites, and programs are covered by non-disclosure and are never named or implied anywhere on this site.</p>
      <div class="regions">
        {SITE.regions.map((r) => (
          <div class="region-row"><span class="region-name">{r}</span><span class="mono accent">ACTIVE</span></div>
        ))}
      </div>
    </div>
    <div class="global-globe"><Globe /></div>
  </section>

  <section class="technology">
    <div class="tech-band"><ImagePlaceholder caption="Full-bleed band, deployed sensor mast or secure radio in the field" src={SITE_PHOTOS.commsMast.src} alt={SITE_PHOTOS.commsMast.alt} objectPosition="center 65%" /></div>
    <div class="tech-inner">
      <div class="eyebrow-row"><span class="mono dim">04 – TECHNOLOGY</span><span class="rule"></span></div>
      <h2>Streamlining Technologies</h2>
      <div class="tech-grid">
        {techItems.map((t) => (
          <div data-reveal class="tech-item">
            <span class="mono accent-ink">{t.n}</span>
            <div class="tech-title">{t.title}</div>
            <p>{t.body}</p>
            <div class="mono tech-tags">{t.tags}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cyber">
    <div class="cyber-left">
      <div class="eyebrow-row"><span class="mono dim">05 – CYBERSECURITY</span><span class="rule"></span></div>
      <h2>Cyber-physical security</h2>
      <p>GSS supports the design, implementation, assessment, and long-term performance of cybersecurity programs in regulated and high-consequence environments. Our team is led by former U.S. NRC inspectors with direct experience developing federal cybersecurity requirements.</p>
      <div class="cyber-micro">
        <div><div class="micro-title">Governance</div><div class="micro-body">Define needs, personalize controls</div></div>
        <div><div class="micro-title">Compliance</div><div class="micro-body">Risk-based programs, demonstrated to regulators</div></div>
        <div><div class="micro-title">Operational</div><div class="micro-body">SOC design, implementation, assessment</div></div>
      </div>
    </div>
    <div class="cyber-list">
      {cyberList.map((label, i) => (
        <div class="cyber-row"><span>{label}</span><span class="mono dim">{String(i + 1).padStart(2, '0')}</span></div>
      ))}
    </div>
  </section>

  <CTASection heading="Best-in-Class Solutions" body="Assessment, design, technology, training, or performance. Tell us the environment and we will tell you where to start." />
</Layout>

<style>
  .dim { color: var(--text-on-paper-quiet); }
  .accent { color: var(--accent) !important; }
  .accent-ink { color: var(--accent-ink) !important; }

  .section-head { display: grid; grid-template-columns: 180px 1fr; gap: 40px; margin-bottom: 44px; }
  .section-idx { letter-spacing: .18em; color: var(--text-on-paper-quiet); line-height: 1.6; }
  .section-idx.dim { color: var(--text-on-ink-tertiary); }
  .head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .eyebrow-row { display: flex; align-items: baseline; gap: 16px; margin-bottom: 30px; }
  .rule { flex: 1; height: 1px; background: var(--paper-border-soft); }
  .global-copy .rule, .tech-inner .rule, .cyber-left .rule { background: var(--paper-border-soft); }
  .global .rule, .tech-inner .rule { background: var(--ink-border); }

  h2 { margin: 0; font: 700 clamp(30px, 4.2vw, 56px)/.98 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; color: var(--text-on-paper-primary); }

  /* HERO */
  .hero { background: var(--ink); }
  .hero-grid { display: grid; grid-template-columns: 1fr 240px; }
  .hero-copy { padding: 70px 0 40px 44px; border-right: 1px solid var(--ink-border); }
  .hero-eyebrow { display: flex; align-items: center; gap: 14px; margin-bottom: 34px; margin-right: 44px; }
  .hero-eyebrow .mono { color: var(--accent); letter-spacing: .22em; font-size: 10px; white-space: nowrap; }
  .hero h1 { margin: 0 44px 0 0; max-width: 20ch; font: 700 clamp(34px, 5.2vw, 68px)/.98 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; color: var(--text-on-ink-primary); }
  .hero-sub { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin: 46px 44px 0 0; padding-top: 30px; border-top: 1px solid var(--ink-border); }
  .hero-sub p { margin: 0; font: 400 17px/1.6 var(--font-body); color: #a9afb5; }
  .hero-ctas { display: flex; align-items: flex-start; gap: 14px; flex-wrap: wrap; }
  .hero-meta { margin: 54px 44px 0 0; padding: 14px 0; border-top: 1px solid var(--ink-border); display: flex; gap: 34px; font-size: 10.5px; letter-spacing: .12em; color: var(--text-on-ink-tertiary); flex-wrap: wrap; }
  .brand-line { margin-left: auto; color: var(--accent); }
  .hero-image { position: relative; min-height: 560px; }

  /* STATS */
  .stats { background: var(--paper); display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--paper-border); }
  .stat { padding: 44px var(--page-pad) 46px 0; border-right: 1px solid var(--paper-border); }
  .stat:last-child { border-right: none; }
  .stat:first-child { padding-left: var(--page-pad); }
  .num { font: 700 clamp(48px, 8vw, 92px)/.86 var(--font-display); letter-spacing: -.05em; color: var(--ink); }
  .stat .label { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--paper-border); font-size: 11px; letter-spacing: .14em; color: var(--text-on-paper-label); }

  /* ARCHITECTURE */
  .architecture { background: var(--paper); padding: 78px var(--page-pad) 84px; border-bottom: 1px solid var(--paper-border); }
  .architecture .section-head p { margin: 0; max-width: 62ch; font: 400 15.5px/1.7 var(--font-body); color: var(--text-on-paper-tertiary); }
  .layers { display: flex; flex-direction: column; }
  .layer { display: grid; grid-template-columns: 260px 1fr; gap: 40px; padding: 22px 0; border-top: 1px solid var(--paper-border-soft); transition: background 200ms var(--ease-out-strong); }
  .layer:first-child { border-top-color: var(--ink); }
  .layer:last-child { border-bottom: 1px solid var(--ink); }
  .layer:hover { background: var(--paper-hover); }
  .layer-label { display: flex; align-items: baseline; gap: 12px; }
  .layer-name { font: 700 26px/1 var(--font-display); letter-spacing: -.02em; text-transform: uppercase; color: var(--ink); }
  .layer-items { display: flex; flex-wrap: wrap; gap: 8px 28px; font: 400 14px/1.4 var(--font-body); color: var(--text-on-paper-tertiary); }


  /* GLOBAL */
  .global { background: var(--ink); display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--ink-border); }
  .global-copy { padding: 78px var(--page-pad) 84px; border-right: 1px solid var(--ink-border); }
  .global-copy h2 { color: var(--text-on-ink-primary); max-width: 18ch; margin-bottom: 18px; }
  .global-copy p { margin: 0 0 34px; max-width: 48ch; font: 400 15px/1.7 var(--font-body); color: var(--text-on-ink-secondary); }
  .regions { display: flex; flex-direction: column; }
  .region-row { display: flex; justify-content: space-between; align-items: baseline; padding: 16px 0; border-top: 1px solid var(--ink-border-soft); }
  .region-row:first-child { border-top-color: var(--ink-border-strong); }
  .region-row:last-child { border-bottom: 1px solid var(--ink-border-strong); }
  .region-name { font: 700 30px/1 var(--font-display); letter-spacing: -.03em; text-transform: uppercase; color: var(--text-on-ink-primary); }
  .global-globe { min-height: 420px; }

  /* TECHNOLOGY */
  .technology { background: var(--paper); border-bottom: 1px solid var(--paper-border); }
  .tech-band { position: relative; height: 220px; border-bottom: 1px solid var(--paper-border); }
  .tech-inner { padding: 60px var(--page-pad) 84px; }
  .tech-inner h2 { margin-bottom: 40px; max-width: 28ch; }
  .tech-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
  .tech-item { padding: 26px 32px 0 0; border-right: 1px solid var(--paper-border-soft); display: flex; flex-direction: column; gap: 12px; }
  .tech-item:last-child { border-right: none; padding-left: 32px; }
  .tech-item:nth-child(2) { padding-left: 32px; }
  .tech-title { font: 700 24px/1.05 var(--font-display); letter-spacing: -.02em; text-transform: uppercase; color: var(--ink); }
  .tech-item p { margin: 0; font: 400 13.5px/1.65 var(--font-body); color: var(--text-on-paper-tertiary); }
  .tech-tags { margin-top: 6px; font-size: 11px; line-height: 1.9; color: var(--text-on-paper-quiet); }

  /* CYBER */
  .cyber { background: var(--paper); padding: 78px var(--page-pad) 84px; border-bottom: 1px solid var(--paper-border); display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .cyber-left h2 { margin-bottom: 20px; max-width: 20ch; font-size: clamp(28px, 3.4vw, 48px); }
  .cyber-left p { margin: 0 0 26px; max-width: 50ch; font: 400 15px/1.7 var(--font-body); color: var(--text-on-paper-tertiary); }
  .cyber-micro { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
  .cyber-micro > div { padding: 16px; border-right: 1px solid var(--paper-border-soft); }
  .cyber-micro > div:first-child { padding-left: 0; }
  .cyber-micro > div:last-child { border-right: none; }
  .micro-title { font: 700 17px/1 var(--font-display); letter-spacing: -.01em; text-transform: uppercase; color: var(--ink); margin-bottom: 6px; }
  .micro-body { font: 400 12px/1.5 var(--font-body); color: var(--text-on-paper-tertiary); }
  .cyber-list { display: flex; flex-direction: column; padding-top: 52px; }
  .cyber-row { display: flex; justify-content: space-between; padding: 12px 0; border-top: 1px solid var(--paper-border-soft); font: 400 14px/1.4 var(--font-body); color: var(--text-on-paper-body-alt); }
  .cyber-row:first-child { border-top-color: var(--ink); }
  .cyber-row:last-child { border-bottom: 1px solid var(--ink); }

  @media (max-width: 1080px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { padding: 50px var(--page-pad) 40px; border-right: none; }
    .hero-eyebrow, .hero-sub, .hero-meta { margin-right: 0; }
    .hero-eyebrow .mono { white-space: normal; line-height: 1.6; }
    .hero h1 { margin-right: 0; }
    .hero-sub { grid-template-columns: 1fr; }
    .hero-image { min-height: 320px; }
    .stats { grid-template-columns: 1fr; }
    .stat { border-right: none !important; border-bottom: 1px solid var(--paper-border); padding-left: var(--page-pad) !important; }
    .section-head { grid-template-columns: 1fr; gap: 16px; }
    .layer { grid-template-columns: 1fr !important; padding-left: 0 !important; gap: 8px; }
    .global { grid-template-columns: 1fr; }
    .global-copy { border-right: none; border-bottom: 1px solid var(--ink-border); }
    .global-globe { min-height: 320px; }
    .tech-grid { grid-template-columns: 1fr; }
    .tech-item { border-right: none !important; padding-left: 0 !important; border-top: 1px solid var(--paper-border-soft); padding-top: 22px !important; }
    .tech-item:first-child { border-top-color: var(--ink); }
    .cyber { grid-template-columns: 1fr; }
    .cyber-list { padding-top: 20px; }
    .cyber > * { min-width: 0; }
  }

  @media (max-width: 600px) {
    .cyber-micro { grid-template-columns: 1fr; }
    .cyber-micro > div { padding-left: 0; border-right: none; border-bottom: 1px solid var(--paper-border-soft); }
    .cyber-micro > div:last-child { border-bottom: none; }
  }
</style>
