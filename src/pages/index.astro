---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { SITE_PHOTOS, PEOPLE_PHOTOS } from '@/lib/images';
import Globe from '@/components/Globe.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE, FOUNDER, LEADERSHIP } from '@/lib/site';

const allInsights = (await getCollection('insights')).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
const [leadInsight, ...restInsights] = allInsights;

const architectureLayers = [
  { n: 'L1', label: 'Physical', items: ['Barrier systems', 'Access control', 'Intrusion detection', 'Surveillance', 'Hardening'] },
  { n: 'L2', label: 'Procedural', items: ['Protective strategy', 'Response planning', 'Training', 'Force-on-force', 'Policy & basis documentation'] },
  { n: 'L3', label: 'Technology', items: ['Secure wireless comms', 'Rapidly deployable IDS', 'Monitoring & alarms', 'Drone programs', 'Systems integration'] },
  { n: 'L4', label: 'Cyber', items: ['Risk-based controls', 'Penetration testing', 'Governance', 'Threat hunting', 'Incident response'] },
  { n: 'L5', label: 'Performance', items: ['KPI development', 'Optimization', 'Leadership', 'Culture', 'Continuous improvement'] },
];

const outsideIn = [
  { step: '01', label: 'Controlled Area', body: 'Approach routes, standoff, and the outer boundary read the way an adversary reads them.' },
  { step: '02', label: 'Physical Security', body: 'Barriers, delay, hardening, and detection measured against DBT capability.' },
  { step: '03', label: 'Electronic Security', body: 'Sensors, assessment, communications, and integration under real conditions.' },
  { step: '04', label: 'Procedural Security', body: 'Protective strategy, response, complement, and the procedures that execute them.' },
  { step: '05', label: 'Vital Areas', body: 'Sabotage and area logic models resolved into candidate vital areas and target sets.' },
];
const insideOut = [
  { step: '01', label: 'Critical Assets', body: 'What must not be reached, and what its loss would actually mean.' },
  { step: '02', label: 'Vital Area Requirements', body: 'Target sets and area logic established before the layout is fixed.' },
  { step: '03', label: 'Protective Strategy', body: 'Response concept and minimum complement designed into the operating model.' },
  { step: '04', label: 'Detection & Delay', body: 'Sensor and barrier selection validated against explosive and tool capability.' },
  { step: '05', label: 'Perimeter Architecture', body: 'The outer boundary designed last, sized by everything inside it.' },
];

const techItems = [
  { n: '01', title: 'Secure Wireless Communications', body: 'Encrypted mesh communications with frequency hopping and dynamic routing, deployable as a compensatory measure or a permanent capability.', tags: 'AES-256 · FIPS 140-3 · MESH / PEER-TO-PEER' },
  { n: '02', title: 'Rapidly Deployable IDS', body: 'Thermal and CCD assessment with buried, fence-mounted, microwave, and taut-wire detection, configured per site to meet regulatory requirements.', tags: 'INTERIM OR PERMANENT · PIDAS-CAPABLE' },
  { n: '03', title: 'Drone Program Development', body: 'Threat assessment, airspace control, detection and tracking, countermeasures, and an escalation framework that stays inside regulation.', tags: 'RADAR · RF · GEO-FENCING · RESPONSE' },
];

const cyberList = ['Security assessments', 'Risk-based security controls', 'Penetration testing', 'Risk & vulnerability management', 'Compliance advisory', 'Governance', 'Threat hunting', 'Incident response', 'Security operations', 'Training & education'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }],
  },
];
---
<Layout
  title="Nuclear Security Consulting, Physical Protection & Compliance | Global Security Solutions"
  description="GSS provides integrated nuclear security consulting, physical protection, technology, cybersecurity, and regulatory solutions for high-value, high-risk critical infrastructure."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="mono">01 — NUCLEAR &amp; CRITICAL INFRASTRUCTURE</span>
          <span class="scan-rule"><span></span></span>
        </div>
        <h1 class="gss-rise">Nuclear security consulting<span class="dim">,</span> physical protection <span class="dim">&amp;</span> critical infrastructure solutions</h1>
        <div class="hero-sub">
          <p>Integrated security, technology, cybersecurity, regulatory, and operational-performance solutions for high-value, high-risk infrastructure.</p>
          <div class="hero-ctas">
            <a class="btn btn-accent" href="/contact/">Request a Consultation</a>
            <a class="btn btn-outline-on-ink" href="/security-solutions/">Explore Capabilities</a>
          </div>
        </div>
        <div class="hero-meta mono">
          <span>{SITE.founded}</span><span>{SITE.regionsLine}</span><span>PHYSICAL · PROCEDURAL · ELECTRONIC</span>
          <span class="brand-line">{SITE.brandLine.toUpperCase()}</span>
        </div>
      </div>
      <div class="hero-image">
        <ImagePlaceholder caption="Hero photo — containment structure or lit perimeter at dusk, tall crop" dark src={SITE_PHOTOS.nuclearDusk.src} alt={SITE_PHOTOS.nuclearDusk.alt} objectPosition="center 30%" />
      </div>
    </div>
  </section>

  <section class="stats">
    <div data-reveal class="stat"><div class="num">{SITE.facilityCount}</div><div class="label mono">NUCLEAR FACILITIES<br />SUPPORTED</div></div>
    <div data-reveal class="stat"><div class="num">{SITE.yearsExperience}</div><div class="label mono">YEARS OF NUCLEAR<br />SECURITY EXPERIENCE</div></div>
    <div data-reveal class="stat"><div class="num">{SITE.regulatoryRegimes}</div><div class="label mono">NATIONAL REGULATORY<br />REGIMES WORKED UNDER</div></div>
  </section>

  <section class="architecture">
    <div class="section-head">
      <div class="section-idx mono">02<br />INTEGRATED<br />ARCHITECTURE</div>
      <div>
        <h2>Security is not a product. It is an architecture.</h2>
        <p>GSS analyzes physical, procedural, and electronic security as one interdependent system, then stays through implementation. Five layers, assessed together, indented here in the order an adversary meets them.</p>
      </div>
    </div>
    <div class="layers">
      {architectureLayers.map((layer, i) => (
        <div data-reveal class="layer" style={`padding-left:${i * 40}px`}>
          <div class="layer-label"><span class="mono accent">{layer.n}</span><span class="layer-name">{layer.label}</span></div>
          <div class="layer-items">{layer.items.map((it) => <span>{it}</span>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="method">
    <div class="section-head">
      <div class="section-idx mono">03<br />METHOD</div>
      <div class="head-row">
        <h2>Two directions of travel</h2>
        <div class="tabs" role="tablist">
          <button class="tab" data-dir="out" role="tab" aria-selected="true">Existing facility · outside → in</button>
          <button class="tab" data-dir="in" role="tab" aria-selected="false">New build · inside → out</button>
        </div>
      </div>
    </div>

    <div class="method-panel" data-panel="out">
      <div class="dots" aria-hidden="true">
        <span class="dot active"></span><span class="line"></span>
        <span class="dot"></span><span class="line"></span>
        <span class="dot"></span><span class="line"></span>
        <span class="dot"></span><span class="line"></span>
        <span class="dot"></span>
      </div>
      <div class="steps">
        {outsideIn.map((s, i) => (
          <div class="step"><span class:list={['mono', i === 0 ? 'accent' : 'dim']}>STEP {s.step}</span><span class="step-label">{s.label}</span><span class="step-body">{s.body}</span></div>
        ))}
      </div>
    </div>
    <div class="method-panel" data-panel="in" hidden>
      <div class="dots" aria-hidden="true">
        <span class="dot"></span><span class="line"></span>
        <span class="dot"></span><span class="line"></span>
        <span class="dot"></span><span class="line"></span>
        <span class="dot"></span><span class="line"></span>
        <span class="dot active"></span>
      </div>
      <div class="steps">
        {insideOut.map((s, i) => (
          <div class="step"><span class:list={['mono', i === 4 ? 'accent' : 'dim']}>STEP {s.step}</span><span class="step-label">{s.label}</span><span class="step-body">{s.body}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="founder">
    <div class="founder-photo">
      <ImagePlaceholder caption="Eric F. Wilson — professional portrait" src={PEOPLE_PHOTOS.eric.src} alt={PEOPLE_PHOTOS.eric.alt} grayscale zoom={1.3} />
    </div>
    <div class="founder-copy">
      <div class="eyebrow-row"><span class="mono dim">04 — FOUNDER &amp; LEGACY</span><span class="rule"></span></div>
      <h2>{FOUNDER.name}</h2>
      <div class="mono founder-title">{FOUNDER.title.toUpperCase()}</div>
      <p>GSS was founded on thirty years of work that ran from special operations to the C-suite. The integrated approach the company practices today — physical, procedural, and electronic security analyzed as one system — came directly out of that career.</p>
      <p>Wade Wilson leads GSS today as President. The standard the company was built on has not moved.</p>
      <div class="timeline">
        {FOUNDER.timeline.map((t) => (
          <div data-reveal class="timeline-row">
            <span class="mono dim">{t.n}</span>
            <span class="timeline-label">{t.label}</span>
            <span class="timeline-body">{t.body}</span>
          </div>
        ))}
      </div>
      <a class="founder-link" href="/founder/">Read the founder story</a>
    </div>
  </section>

  <section class="leadership">
    <div class="eyebrow-row"><span class="mono dim">05 — LEADERSHIP TODAY</span><span class="rule"></span></div>
    <div class="leadership-grid">
      <div class="lead-card">
        <div class="lead-photo"><ImagePlaceholder caption="Wade Wilson — professional portrait" src={PEOPLE_PHOTOS.wade.src} alt={PEOPLE_PHOTOS.wade.alt} grayscale zoom={1.3} /></div>
        <div class="lead-copy">
          <div class="lead-name">{LEADERSHIP.name}</div>
          <div class="mono lead-title">{LEADERSHIP.eyebrow}</div>
          {LEADERSHIP.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="who-does-work">
        <div class="who-title">Who does the work</div>
        <p class="who-intro">{LEADERSHIP.teamIntro}</p>
        <div class="who-roster">
          {LEADERSHIP.teamRoster.map((r, i) => (
            <div class="who-row">
              <span class="mono who-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="who-label">{r.label}</span>
              <span class="who-detail">{r.detail}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="global">
    <div class="global-copy">
      <div class="eyebrow-row"><span class="mono dim">06 — GLOBAL EXPERIENCE</span><span class="rule"></span></div>
      <h2>Regions, not clients</h2>
      <p>Nuclear facilities and critical infrastructure across three regions. Client organizations, sites, and programs are covered by non-disclosure and are never named or implied anywhere on this site.</p>
      <div class="regions">
        {SITE.regions.map((r) => (
          <div class="region-row"><span class="region-name">{r}</span><span class="mono accent">ACTIVE</span></div>
        ))}
      </div>
      <div class="mono global-note">GLOBE HIGHLIGHTS COUNTRIES OF DEMONSTRATED EXPERIENCE ONLY — NO SITE MARKERS, NO NAMES</div>
    </div>
    <div class="global-globe"><Globe /></div>
  </section>

  <section class="technology">
    <div class="tech-band"><ImagePlaceholder caption="Full-bleed band — deployed sensor mast or secure radio in the field" src={SITE_PHOTOS.commsMast.src} alt={SITE_PHOTOS.commsMast.alt} objectPosition="center 65%" /></div>
    <div class="tech-inner">
      <div class="eyebrow-row"><span class="mono dim">07 — TECHNOLOGY</span><span class="rule"></span></div>
      <h2>Technology chosen to remove recurring cost, not add it</h2>
      <div class="tech-grid">
        {techItems.map((t) => (
          <div data-reveal class="tech-item">
            <span class="mono accent-ink">{t.n}</span>
            <div class="tech-title">{t.title}</div>
            <p>{t.body}</p>
            <div class="mono tech-tags">{t.tags}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hpo">
    <div class="section-head">
      <div class="section-idx mono dim">08<br />HIGH<br />PERFORMANCE</div>
      <div class="head-row">
        <h2>From compliance to best-in-class</h2>
        <p>Automated indicators that show a negative trend before it becomes an event, aligned to INPO, WANO, and IAEA principles.</p>
      </div>
    </div>
    <div class="hpo-body">
      <div class="hpo-steps">
        {[
          ['01', 'Track', 'Automated KPI capture built from benchmarking and subject matter expertise.'],
          ['02', 'Trend', 'Leading and lagging indicators separated so decline is visible early.'],
          ['03', 'Measure', 'Performance measured against defined Best-in-Class criteria.'],
          ['04', 'Improve', 'Roadmap, milestones, and phased implementation toward the target state.'],
        ].map(([n, label, body]) => (
          <div data-reveal class="hpo-row"><span class="mono accent">{n}</span><span class="hpo-label">{label}</span><span class="hpo-body">{body}</span></div>
        ))}
      </div>
      <div class="kpi-card">
        <div class="kpi-head"><span class="mono">KPI DASHBOARD</span><span class="mono dim small">ILLUSTRATIVE — NOT CLIENT DATA</span></div>
        <div class="kpi-bars">
          {[34, 48, 42, 61, 55, 72, 80, 92].map((h, i) => (
            <div class="bar" style={`height:${h}%`} data-hi={i >= 6 ? 'true' : 'false'}></div>
          ))}
        </div>
        <div class="kpi-rule"></div>
        <div class="kpi-labels mono"><span>BASELINE</span><span>ROADMAP</span><span>BEST-IN-CLASS</span></div>
      </div>
    </div>
  </section>

  <section class="cyber">
    <div class="cyber-left">
      <div class="eyebrow-row"><span class="mono dim">09 — CYBERSECURITY</span><span class="rule"></span></div>
      <h2>Cyber-physical security for nuclear infrastructure</h2>
      <p>A lifecycle offering spanning design, implementation, authority to operate, and maintenance — led by former U.S. NRC inspectors who authored the regulations now governing U.S. plants.</p>
      <div class="cyber-micro">
        <div><div class="micro-title">Governance</div><div class="micro-body">Define needs, personalize controls</div></div>
        <div><div class="micro-title">Compliance</div><div class="micro-body">Risk-based programs, demonstrated to regulators</div></div>
        <div><div class="micro-title">Operational</div><div class="micro-body">SOC design, implementation, assessment</div></div>
      </div>
    </div>
    <div class="cyber-list">
      {cyberList.map((label, i) => (
        <div class="cyber-row"><span>{label}</span><span class="mono dim">{String(i + 1).padStart(2, '0')}</span></div>
      ))}
    </div>
  </section>

  <section class="insights">
    <div class="eyebrow-row"><span class="mono dim">10 — INSIGHTS</span><span class="rule"></span><a class="mono all-insights" href="/insights/">All insights</a></div>
    <div class="insights-grid">
      {leadInsight && (
        <a data-reveal class="lead-article" href={`/insights/${leadInsight.id}/`}>
          <span class="mono accent-ink">{leadInsight.data.category.toUpperCase()} · {leadInsight.data.readMinutes} MIN</span>
          <h3>{leadInsight.data.title}</h3>
          <p>{leadInsight.data.dek}</p>
        </a>
      )}
      <div class="teaser-list">
        {restInsights.slice(0, 4).map((a) => (
          <a class="teaser" href={`/insights/${a.id}/`}>
            <span class="mono dim">{a.data.category.toUpperCase()} · {a.data.readMinutes} MIN</span>
            <span class="teaser-title">{a.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection heading="Bring us in early. Or bring us in now." body="Assessment, design, technology, training, or performance. Tell us the environment and we will tell you where to start." />
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.method .tab');
  const panels = document.querySelectorAll<HTMLElement>('.method-panel');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const dir = tab.dataset.dir;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => { p.hidden = p.dataset.panel !== dir; });
    });
  });
</script>

<style>
  .dim { color: var(--text-on-paper-quiet); }
  .accent { color: var(--accent) !important; }
  .accent-ink { color: var(--accent-ink) !important; }

  .section-head { display: grid; grid-template-columns: 180px 1fr; gap: 40px; margin-bottom: 44px; }
  .section-idx { letter-spacing: .18em; color: var(--text-on-paper-quiet); line-height: 1.6; }
  .section-idx.dim { color: var(--text-on-ink-tertiary); }
  .head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .eyebrow-row { display: flex; align-items: baseline; gap: 16px; margin-bottom: 30px; }
  .rule { flex: 1; height: 1px; background: var(--paper-border-soft); }
  .founder-copy .rule, .leadership .rule, .global-copy .rule, .tech-inner .rule, .cyber-left .rule { background: var(--paper-border-soft); }
  .global .rule, .tech-inner .rule { background: var(--ink-border); }

  h2 { margin: 0; font: 700 clamp(30px, 4.2vw, 56px)/.98 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; color: var(--text-on-paper-primary); }

  /* HERO */
  .hero { background: var(--ink); }
  .hero-grid { display: grid; grid-template-columns: 1fr 240px; }
  .hero-copy { padding: 70px 0 40px 44px; border-right: 1px solid var(--ink-border); }
  .hero-eyebrow { display: flex; align-items: center; gap: 14px; margin-bottom: 34px; margin-right: 44px; }
  .hero-eyebrow .mono { color: var(--accent); letter-spacing: .22em; font-size: 10px; white-space: nowrap; }
  .hero h1 { margin: 0 44px 0 0; max-width: 20ch; font: 700 clamp(34px, 5.2vw, 68px)/.98 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; color: var(--text-on-ink-primary); }
  .hero-sub { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin: 46px 44px 0 0; padding-top: 30px; border-top: 1px solid var(--ink-border); }
  .hero-sub p { margin: 0; font: 400 17px/1.6 var(--font-body); color: #a9afb5; }
  .hero-ctas { display: flex; align-items: flex-start; gap: 14px; flex-wrap: wrap; }
  .hero-meta { margin: 54px 44px 0 0; padding: 14px 0; border-top: 1px solid var(--ink-border); display: flex; gap: 34px; font-size: 10.5px; letter-spacing: .12em; color: var(--text-on-ink-tertiary); flex-wrap: wrap; }
  .brand-line { margin-left: auto; color: var(--accent); }
  .hero-image { position: relative; min-height: 560px; }

  /* STATS */
  .stats { background: var(--paper); display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--paper-border); }
  .stat { padding: 44px var(--page-pad) 46px 0; border-right: 1px solid var(--paper-border); }
  .stat:last-child { border-right: none; }
  .stat:first-child { padding-left: var(--page-pad); }
  .num { font: 700 clamp(48px, 8vw, 92px)/.86 var(--font-display); letter-spacing: -.05em; color: var(--ink); }
  .stat .label { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--paper-border); font-size: 11px; letter-spacing: .14em; color: var(--text-on-paper-label); }

  /* ARCHITECTURE */
  .architecture { background: var(--paper); padding: 78px var(--page-pad) 84px; border-bottom: 1px solid var(--paper-border); }
  .architecture .section-head p { margin: 0; max-width: 62ch; font: 400 15.5px/1.7 var(--font-body); color: var(--text-on-paper-tertiary); }
  .layers { display: flex; flex-direction: column; }
  .layer { display: grid; grid-template-columns: 180px 1fr; gap: 40px; padding: 22px 0; border-top: 1px solid var(--paper-border-soft); transition: background 200ms var(--ease-out-strong); }
  .layer:first-child { border-top-color: var(--ink); }
  .layer:last-child { border-bottom: 1px solid var(--ink); }
  .layer:hover { background: var(--paper-hover); }
  .layer-label { display: flex; align-items: baseline; gap: 12px; }
  .layer-name { font: 700 26px/1 var(--font-display); letter-spacing: -.02em; text-transform: uppercase; color: var(--ink); }
  .layer-items { display: flex; flex-wrap: wrap; gap: 8px 28px; font: 400 14px/1.4 var(--font-body); color: var(--text-on-paper-tertiary); }


  /* METHOD */
  .method { background: var(--paper); padding: 78px var(--page-pad) 84px; border-bottom: 1px solid var(--paper-border); }
  .method .head-row p { display: none; }
  .tabs { display: flex; border: 1px solid var(--ink); }
  .tab { font: 600 11.5px/1 var(--font-body); letter-spacing: .08em; text-transform: uppercase; padding: 14px 18px; cursor: pointer; border: none; background: transparent; color: var(--text-on-paper-tertiary); transition: background 160ms var(--ease-out-strong), color 160ms ease; }
  .tab[aria-selected="true"] { background: var(--ink); color: var(--text-on-ink-primary); }
  .dots { display: flex; align-items: center; margin: 0 0 26px; }
  .dot { width: 7px; height: 7px; background: var(--ink); }
  .dot.active { width: 11px; height: 11px; background: var(--accent); }
  .line { flex: 1; height: 1px; background: var(--ink); }
  .steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px; }
  .step { display: flex; flex-direction: column; gap: 10px; }
  .step .mono { font-size: 10px; letter-spacing: .14em; }
  .step-label { font: 700 22px/1.05 var(--font-display); letter-spacing: -.02em; text-transform: uppercase; color: var(--ink); }
  .step-body { font: 400 13.5px/1.6 var(--font-body); color: var(--text-on-paper-tertiary); }

  /* FOUNDER */
  .founder { background: var(--paper); border-bottom: 1px solid var(--paper-border); display: grid; grid-template-columns: 300px 1fr; }
  .founder-photo { border-right: 1px solid var(--paper-border); min-height: 520px; }
  .founder-copy { padding: 78px var(--page-pad) 84px; }
  .founder-copy h2 { margin: 0 0 10px; font-size: clamp(32px, 5vw, 68px); line-height: .94; letter-spacing: -.04em; }
  .founder-title { font-size: 11px; letter-spacing: .16em; color: var(--accent-ink); margin-bottom: 26px; }
  .founder-copy p { margin: 0 0 20px; max-width: 66ch; font: 400 16px/1.7 var(--font-body); color: var(--text-on-paper-secondary); }
  .timeline { display: flex; flex-direction: column; margin-top: 14px; }
  .timeline-row { display: grid; grid-template-columns: 90px 200px 1fr; gap: 24px; padding: 18px 0; border-top: 1px solid var(--paper-border-soft); }
  .timeline-row:first-child { border-top-color: var(--ink); }
  .timeline-row:last-child { border-bottom: 1px solid var(--ink); }
  .timeline-label { font: 700 19px/1.1 var(--font-display); letter-spacing: -.015em; text-transform: uppercase; color: var(--ink); }
  .timeline-body { font: 400 13.5px/1.6 var(--font-body); color: var(--text-on-paper-tertiary); }
