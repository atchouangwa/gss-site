---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { INDUSTRIES, SOLUTIONS } from '@/lib/site';

// Nuclear has its own section (/nuclear-security/); the other industries share this template.
// Pages without approved copy use general GSS copy only and carry a visible placeholder note.
// All industry pages stay out of search results until the client approves them for publishing.
// Each page: two content sections (heading + one existing paragraph) and, where the copy
// has one, a lead-in sentence for the capability list.
type IndustryCopy = { dek?: string; sections: { heading: string; body: string }[]; indexIntro?: string };

const COPY: Record<string, IndustryCopy> = {
  'oil-gas': {
    dek: 'Critical energy infrastructure is assessed comprehensively, addressing all aspects of security. GSS possesses the resources and personnel to meet all corporate and regulatory requirements of the oil and gas sector, including enterprise security and OT/ICS needs.',
    sections: [
      { heading: 'Regulatory Compliance', body: "TSA and government compliance requires expertise and knowledge that our team brings. Our ability to effectively evaluate IT/OT/ICS infrastructure and respond with solutions in a timely and efficient manner speaks to our team's dedication and proficiency." },
      { heading: 'Field Solutions', body: 'GSS assesses how those elements work together and supports security planning, design, and program improvement. For existing facilities, we evaluate established measures and identify gaps. For new developments or expansions, we help organizations incorporate security into facility planning and operations.' },
    ],
    indexIntro: "The solutions below can address individual needs or support a broader security program based on the organization's priorities.",
  },
  'data-centers': {
    dek: 'Data center security must account for equipment, controlled access, personnel and contractor activity, and the continuity of site operations. As facilities develop and portfolios grow, GSS provides the assessments and solutions for changing regulations across locations.',
    sections: [
      { heading: 'Data Center Environments', body: "Data centers' rapid growth is unprecedented and represents the next pioneering feat within the critical infrastructure field. This sector requires detail-oriented personnel with a deep understanding of physical and cybersecurity support, which is the foundation on which GSS operates." },
      { heading: 'Best-in-Class Amendments', body: 'GSS evaluates how personnel, procedures, technology, and response work together as one integrated system. We support organizations in assessing established security programs, planning protection for new facilities, and strengthening consistency across multiple sites.' },
    ],
    indexIntro: "Our work spans security assessment and design, technology integration, cybersecurity, and operational performance. The solutions below can be applied individually or combined according to the organization's priorities.",
  },
};

const PENDING: IndustryCopy = {
  sections: [
    { heading: 'Systematic Security', body: 'GSS evaluates how personnel, procedures, technology, and response work together, not how each component performs on its own. We identify gaps between those elements and help strengthen the overall security program from assessment through implementation.' },
    { heading: 'Striving for Efficiency', body: 'We work with organizations from initial assessment and planning through implementation and long-term program improvement.' },
  ],
};

export function getStaticPaths() {
  return INDUSTRIES.filter((i) => i.href.startsWith('/industries/')).map((i) => ({
    params: { slug: i.href.split('/')[2] },
    props: { label: i.label, path: i.href },
  }));
}

const { label, path } = Astro.props;
const slug = path.split('/')[2];
const copy = COPY[slug] ?? PENDING;
---
<FamilyOverviewLayout
  eyebrow="INDUSTRIES"
  title={label}
  dek={copy.dek}
  pendingNote={copy.dek ? undefined : 'INDUSTRY-SPECIFIC COPY TO BE SUPPLIED'}
  path={path}
  metaDescription={copy.dek ?? 'Security assessment, design, technology, cybersecurity, and operational performance services from Global Security Solutions.'}
  sections={copy.sections}
  indexIntro={copy.indexIntro}
  children={SOLUTIONS.map((s) => ({ label: s.label, href: s.path }))}
  ctaHeading="Best-in-Class Solutions"
  noindex
/>
