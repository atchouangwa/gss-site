---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { INDUSTRIES, SOLUTIONS } from '@/lib/site';

// Nuclear has its own section (/nuclear-security/); the other industries share this template.
// Pages without approved copy use general GSS copy only and carry a visible placeholder note.
// All industry pages stay out of search results until the client approves them for publishing.
// Each page: two content sections (heading + one existing paragraph) and, where the copy
// has one, a lead-in sentence for the capability list.
type IndustryCopy = { dek?: string; sections: { heading: string; body: string }[]; indexIntro?: string };

const COPY: Record<string, IndustryCopy> = {
  'oil-gas': {
    dek: 'Integrated security support for oil and gas facilities, with consideration for critical assets, site operations, and continuity.',
    sections: [
      { heading: 'Oil and Gas Environments', body: 'Security in oil and gas environments must account for how facilities operate, how personnel and contractors access the site, and which assets require protection. Physical protection, monitoring, communications, cybersecurity, and response all contribute to the effectiveness of the overall program.' },
      { heading: 'How GSS Helps', body: 'GSS assesses how those elements work together and supports security planning, design, and program improvement. For existing facilities, we evaluate established measures and identify gaps. For new developments or expansions, we help organizations incorporate security into facility planning and operations.' },
    ],
    indexIntro: "The solutions below can address individual needs or support a broader security program based on the organization's priorities.",
  },
  'data-centers': {
    dek: 'Integrated physical and cyber-physical security support for operating data centers, new developments, and expanding portfolios.',
    sections: [
      { heading: 'Data Center Environments', body: 'Data center security must account for critical equipment, controlled access, personnel and contractor activity, and the continuity of site operations. As facilities develop and portfolios grow, security programs also need to accommodate changing requirements across locations.' },
      { heading: 'How GSS Helps', body: 'GSS evaluates how personnel, procedures, technology, and response work together as one integrated system. We support organizations in assessing established security programs, planning protection for new facilities, and strengthening consistency across multiple sites.' },
    ],
    indexIntro: "Our work spans security assessment and design, technology integration, cybersecurity, and operational performance. The solutions below can be applied individually or combined according to the organization's priorities.",
  },
};

const PENDING: IndustryCopy = {
  sections: [
    { heading: 'Security Must Work as a System', body: 'GSS evaluates how personnel, procedures, technology, and response work together, not how each component performs on its own. We identify gaps between those elements and help strengthen the overall security program from assessment through implementation.' },
    { heading: 'Assessment Through Improvement', body: 'We work with organizations from initial assessment and planning through implementation and long-term program improvement.' },
  ],
};

export function getStaticPaths() {
  return INDUSTRIES.filter((i) => i.href.startsWith('/industries/')).map((i) => ({
    params: { slug: i.href.split('/')[2] },
    props: { label: i.label, path: i.href },
  }));
}

const { label, path } = Astro.props;
const slug = path.split('/')[2];
const copy = COPY[slug] ?? PENDING;
---
<FamilyOverviewLayout
  eyebrow="INDUSTRIES"
  title={label}
  dek={copy.dek}
  pendingNote={copy.dek ? undefined : 'INDUSTRY-SPECIFIC COPY TO BE SUPPLIED'}
  path={path}
  metaDescription={copy.dek ?? 'Security assessment, design, technology, cybersecurity, and operational performance services from Global Security Solutions.'}
  sections={copy.sections}
  indexIntro={copy.indexIntro}
  children={SOLUTIONS.map((s) => ({ label: s.label, href: s.path }))}
  ctaHeading="Best-in-Class Solutions"
  noindex
/>
