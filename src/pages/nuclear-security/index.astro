---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/nuclear-security/')!;
---
<FamilyOverviewLayout
  eyebrow="NUCLEAR & SMR"
  title="Nuclear Security"
  dek="GSS is the premier provider of security assessments and design, regulatory support, technology integration, and performance optimization for new build and established nuclear facilities."
  path="/nuclear-security/"
  metaDescription="GSS nuclear security services, including consulting, SMR security, new nuclear build security, and regulatory support, backed by 50+ nuclear facilities supported and 20+ years of experience."
  sections={[
    { heading: 'Nuclear Experience', body: "Our team of professionals includes legislative and corporate leaders who will discover and solve gaps in physical protection regulatory requirements, cybersecurity vulnerability assessments, Force-on-Force operations, and operational performance." },
    { heading: 'Integrated Security Approach', body: "We support both operating facilities and new-build programs, from evaluating and strengthening established security programs to developing security architecture for facilities still in design. Our work considers how personnel, procedures, technology, and response perform together under regulatory and operational requirements." },
  ]}
  children={family.children}
  ctaHeading="Bring nuclear-specific security expertise into your program."
/>
