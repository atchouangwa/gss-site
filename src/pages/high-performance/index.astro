---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/high-performance/')!;
---
<FamilyOverviewLayout
  eyebrow="HIGH PERFORMANCE"
  title="High Performance"
  dek="Performance measurement designed to identify negative trends early, strengthen decision-making, and support continuous improvement."
  path="/high-performance/"
  metaDescription="GSS high-performance operations services, including culture, optimization assessment, KPI development, risk-based decision making, and leadership transformation for security and operations organizations."
  paragraphs={[
    "High-performing security programs require more than meeting regulatory requirements. GSS helps organizations understand how their programs are performing over time, identify negative trends early, and focus improvement efforts where they will have the greatest impact.",
    "Our approach combines performance indicators, automated data collection, benchmarking, and structured improvement planning. By distinguishing leading indicators from lagging results, organizations can identify developing issues earlier and act before they become larger performance or security concerns. GSS applies performance principles informed by recognized industry frameworks, including INPO, WANO, and IAEA guidance.",
  ]}
  children={family.children}
  ctaHeading="Move from compliant to best-in-class."
/>
