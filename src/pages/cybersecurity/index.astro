---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/cybersecurity/')!;
---
<FamilyOverviewLayout
  eyebrow="CYBERSECURITY"
  title="Cyber-Physical Security"
  dek="GSS supports the design, implementation, assessment, and long-term performance of cybersecurity programs in regulated and high-consequence environments. Our team is led by former U.S. NRC inspectors with direct experience developing federal cybersecurity requirements."
  path="/cybersecurity/"
  metaDescription="GSS cybersecurity services, including cyber-physical security, risk-based controls, penetration testing, vulnerability management, compliance advisory, threat hunting, and incident response for nuclear and critical infrastructure."
  sections={[
    { heading: 'Cyber and Physical, Assessed Together', body: "Cybersecurity and physical security increasingly depend on the same systems, infrastructure, and operational processes. GSS evaluates those connections together to identify vulnerabilities that may be missed when cyber and physical security are assessed separately." },
    { heading: 'Understanding Dependencies', body: "Our approach considers how digital systems interact with physical protection, access control, monitoring, communications, and other operational technologies. The goal is to understand where dependencies exist, how a disruption could affect the broader security program, and where additional controls or improvements may be needed." },
  ]}
  indexIntro="The capabilities below can support individual cybersecurity needs or work together as part of a broader cyber-physical security program."
  children={family.children}
  variant="solution"
  ctaHeading="Bring cyber and physical security into one program."
/>
