---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/cybersecurity/')!;
---
<FamilyOverviewLayout
  eyebrow="CYBERSECURITY"
  title="Cybersecurity Solutions"
  dek="GSS supports the design, implementation, assessment, and long-term performance of cybersecurity programs in regulated and high-consequence environments."
  path="/cybersecurity/"
  metaDescription="GSS cybersecurity services, including cyber-physical security, risk-based controls, penetration testing, vulnerability management, compliance advisory, threat hunting, and incident response for nuclear and critical infrastructure."
  sections={[
    { heading: 'Multifaceted Assessments', body: "Cybersecurity can be compromised by inadequate physical restrictions on access to critical areas and networks. GSS takes these factors into account when performing vulnerability assessments for highly regulated environments." },
    { heading: 'Compliance', body: "Our team is led by former U.S. NRC inspectors with direct experience developing federal cybersecurity requirements. We excel in understanding cybersecurity regulations and helping clients achieve compliance in complex sectors." },
  ]}
  indexIntro="The capabilities below can support individual cybersecurity needs or work together as part of a broader cyber-physical security program."
  children={family.children}
  variant="solution"
  ctaHeading="Bring cyber and physical security into one program."
/>
