---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Globe from '@/components/Globe.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE } from '@/lib/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: SITE.url + '/about/' },
      { '@type': 'ListItem', position: 3, name: 'Global Experience', item: SITE.url + '/global-experience/' },
    ],
  },
];
---
<Layout
  title="Global Experience | GSS"
  description="Global Security Solutions supports nuclear facilities and critical infrastructure across North America, Europe, and the Middle East. Client and site details remain confidential."
  path="/global-experience/"
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Global Experience' }]} />

  <section class="hero">
    <div class="copy">
      <span class="mono eyebrow accent-ink">GLOBAL EXPERIENCE</span>
      <h1>Regions, not clients</h1>
      <p>Nuclear facilities and critical infrastructure across three regions. Client organizations, sites, and programs are covered by non-disclosure and are never named or implied anywhere on this site — reach is communicated as regions and, below, as a globe highlighting countries of demonstrated experience.</p>
      <div class="stats">
        <div><div class="num">{SITE.facilityCount}</div><div class="mono label">FACILITIES SUPPORTED</div></div>
        <div><div class="num">{SITE.yearsExperience}</div><div class="mono label">YEARS OF EXPERIENCE</div></div>
        <div><div class="num">{SITE.regulatoryRegimes}</div><div class="mono label">REGULATORY REGIMES</div></div>
      </div>
    </div>
  </section>

  <section class="globe-section">
    <div class="regions">
      {SITE.regions.map((r) => (
        <div class="region-row"><span class="region-name">{r}</span><span class="mono accent">ACTIVE</span></div>
      ))}
    </div>
    <div class="globe-wrap"><Globe /></div>
  </section>

  <CTASection heading="Working outside these regions?" body="Tell us the environment. Nuclear-security and critical-infrastructure engagements are evaluated case by case, wherever they are." />
</Layout>

<style>
  .accent-ink { color: var(--accent-ink); }
  .accent { color: var(--accent); }
  .hero { background: var(--ink); padding: 64px var(--page-pad) 56px; }
  .copy { max-width: var(--max-content); margin: 0 auto; }
  .eyebrow { letter-spacing: .2em; font-size: 10px; margin-bottom: 24px; display: block; }
  .hero h1 { margin: 0 0 22px; font: 700 clamp(34px, 5.5vw, 64px)/1 var(--font-display); letter-spacing: -.04em; text-transform: uppercase; color: var(--text-on-ink-primary); }
  .hero p { margin: 0 0 40px; max-width: 68ch; font: 400 16px/1.75 var(--font-body); color: var(--text-on-ink-secondary); }
  .stats { display: flex; gap: 56px; flex-wrap: wrap; }
  .num { font: 700 56px/1 var(--font-display); letter-spacing: -.04em; color: var(--text-on-ink-primary); }
  .label { margin-top: 10px; font-size: 10px; letter-spacing: .14em; color: var(--text-on-ink-tertiary); }

  .globe-section { max-width: var(--max-content); margin: 0 auto; padding: 56px var(--page-pad) 70px; }
  .regions { display: flex; flex-direction: column; margin-bottom: 26px; }
  .region-row { display: flex; justify-content: space-between; align-items: baseline; padding: 16px 0; border-top: 1px solid var(--paper-border-soft); }
  .region-row:first-child { border-top-color: var(--ink); }
  .region-row:last-child { border-bottom: 1px solid var(--ink); }
  .region-name { font: 700 30px/1 var(--font-display); letter-spacing: -.03em; text-transform: uppercase; color: var(--ink); }
  .globe-wrap { height: 520px; margin-bottom: 18px; }
</style>
