---
import FamilyOverviewLayout from '@/layouts/FamilyOverviewLayout.astro';
import { NAV } from '@/lib/site';

const family = NAV.find((n) => n.path === '/technology/')!;
---
<FamilyOverviewLayout
  eyebrow="TECHNOLOGY SOLUTIONS"
  title="Technology Solutions"
  dek="GSS selects and integrates technology around the needs of the security program, with consideration for performance, reliability, and long-term operating costs."
  path="/technology/"
  metaDescription="GSS technology solutions, including secure wireless communications, rapidly deployable intrusion detection, drone security, systems integration, and remote security operations."
  sections={[
    { heading: 'Expanding Technology', body: "GSS evaluates technology based on the role it serves within the security program. We consider what it needs to detect, delay, monitor, or control, how it integrates with existing systems, and what it will require to operate and maintain over time." },
    { heading: 'Innovation', body: "GSS understands and partners with innovators in security technologies. Our team provides up-to-date equipment tailored to each client's needs." },
  ]}
  indexIntro="The capabilities below can be applied individually or integrated into a broader security program based on the needs of the facility."
  children={family.children}
  variant="solution"
  ctaHeading="Tell us what the protective strategy still needs to detect or delay."
/>
