# Copy to .env and fill in. Never commit the real .env file.

# Resend (https://resend.com) API key used by src/pages/api/contact.ts to deliver
# consultation-request submissions to contact@gsscorporate.com.
RESEND_API_KEY=

# The "from" address Resend sends as. Must be on a domain verified in the Resend account
# (contact@gsscorporate.com itself can be used only once that domain is verified with Resend —
# until then, use a subdomain/address Resend has already verified, e.g. a resend.dev sandbox
# address for testing).
CONTACT_FROM_EMAIL=GSS Website <noreply@gsscorporate.com>
